<!-- ============================================================
  GEMPAGES · Elemento "Liquid" (Custom code)
  Bloque: Diseño que se ve / Colores / Estilo y Calidad
  1) Sube las 4 fotos en Shopify > Contenido > Archivos y copia el enlace de cada una
     (botón de copiar enlace, empieza con https://cdn.shopify.com/...).
     Pega cada enlace donde dice PEGA_AQUI_URL_... (entre las comillas de src="").
  2) Pega TODO este código en el elemento Liquid de GemPages.
  Los textos se editan directo abajo. Los colores y tamaños, en :root (.kfgc).
============================================================= -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

<style>
  /* ===== EDITA AQUÍ: colores, fuente y tamaños ===== */
  .kfgc {
    --kfgc-fondo: #ececec;
    --kfgc-texto: #151515;
    --kfgc-acento: #a0521d;      /* 2ª línea del titular */
    --kfgc-acento-2: #c8732a;    /* "A TU GUSTO." */
    --kfgc-tarjeta: #ffffff;     /* fondo de las tarjetas */
    --kfgc-arco: #c8732a;        /* color del arco de luz del fondo */
    --kfgc-fuente: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --kfgc-titulo-max: 72px;     /* tamaño máximo del titular en PC */
    --kfgc-radio: 18px;          /* redondeo de las tarjetas */
    --kfgc-ancho: 1040px;        /* ancho máximo del contenido */
  }

  /* ===== Base (no hace falta tocar) ===== */
  .kfgc, .kfgc *, .kfgc *::before, .kfgc *::after { box-sizing: border-box; }
  .kfgc :is(h2, h3, p) { margin: 0; padding: 0; }
  .kfgc img { display: block; max-width: 100%; height: auto; border: 0; }

  .kfgc {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    padding: 40px 0;
    color: var(--kfgc-texto);
    font-family: var(--kfgc-fuente);
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
    /* Fondo con luz suave (sin imagen, no pesa nada) */
    background:
      radial-gradient(90% 45% at 50% 0%, rgba(255, 255, 255, 0.95), transparent 70%),
      radial-gradient(60% 35% at 0% 38%, rgba(255, 255, 255, 0.85), transparent 70%),
      linear-gradient(180deg, #f8f8f8, var(--kfgc-fondo) 55%, #f4f4f4);
  }
  /* Arco de luz de un solo color a la derecha (color en --kfgc-arco) */
  .kfgc::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(circle at 105% 42%,
      transparent 44%,
      color-mix(in srgb, var(--kfgc-arco) 18%, transparent) 46.5%,
      color-mix(in srgb, var(--kfgc-arco) 18%, transparent) 49%,
      transparent 51.5%);
    filter: blur(2px);
  }
  .kfgc__wrap { max-width: var(--kfgc-ancho); margin: 0 auto; padding: 0 16px; }

  /* ===== Encabezado ===== */
  .kfgc__head { text-align: center; }
  .kfgc__titulo {
    font-family: var(--kfgc-fuente);
    font-size: clamp(22px, 6.3vw, var(--kfgc-titulo-max));
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--kfgc-texto);
  }
  .kfgc__titulo span { display: block; }
  .kfgc__titulo span + span { color: var(--kfgc-acento); }
  .kfgc__linea {
    width: min(440px, 72%);
    height: 2px;
    margin: 18px auto 14px;
    background: linear-gradient(90deg, transparent, var(--kfgc-texto) 50%, transparent);
    opacity: 0.85;
  }
  .kfgc__sub {
    font-size: clamp(13px, 3.7vw, 20px);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .kfgc__sub em { font-style: normal; color: var(--kfgc-acento-2); }

  /* ===== Variantes de color ===== */
  .kfgc__variantes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 22px;
  }
  .kfgc__var {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .kfgc__var img {
    width: 100%;
    max-width: 340px;
    aspect-ratio: 38 / 30;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .kfgc__nombre {
    margin-top: 10px;
    padding: 0 0 6px 0.4em;
    border-bottom: 3px solid var(--kfgc-linea, var(--kfgc-texto));
    font-size: clamp(12px, 3.4vw, 16px);
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  /* ===== Tarjetas ===== */
  .kfgc__tarjetas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 30px;
  }
  .kfgc__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--kfgc-radio);
    background: var(--kfgc-tarjeta);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
  }
  .kfgc__foto { position: relative; aspect-ratio: 5 / 4; }
  .kfgc__foto img { width: 100%; height: 100%; object-fit: cover; }
  /* Difuminado de la foto hacia el blanco, donde va el texto */
  .kfgc__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, var(--kfgc-tarjeta));
  }
  .kfgc__cuerpo { position: relative; margin-top: -14px; padding: 0 12px 18px; }
  .kfgc__card-titulo {
    font-family: var(--kfgc-fuente);
    font-size: clamp(22px, 6.6vw, 58px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--kfgc-texto);
  }
  .kfgc__card-texto {
    margin-top: 8px;
    font-size: clamp(10.5px, 2.9vw, 17px);
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .kfgc__card-texto strong { font-weight: 800; }

  /* ===== PC / tablet ===== */
  @media (min-width: 750px) {
    .kfgc { padding: 64px 0; }
    .kfgc__variantes { gap: 40px; margin-top: 36px; }
    .kfgc__tarjetas { gap: 20px; margin-top: 44px; }
    .kfgc__cuerpo { margin-top: -24px; padding: 0 24px 28px; }
    .kfgc__card-titulo { font-size: clamp(36px, 5vw, 58px); }
    .kfgc__card-texto { font-size: clamp(13px, 1.6vw, 17px); }
  }
</style>

<section class="kfgc">
  <div class="kfgc__wrap">

    <!-- ===== ENCABEZADO ===== -->
    <div class="kfgc__head">
      <h2 class="kfgc__titulo">
        <span>Diseño que se ve.</span>
        <span>Sonido que se siente.</span>
      </h2>
      <div class="kfgc__linea" aria-hidden="true"></div>
      <p class="kfgc__sub">Dos colores que se adaptan <em>a tu gusto.</em></p>
    </div>

    <!-- ===== VARIANTES (cambia la foto, el nombre y el color de la línea) ===== -->
    <div class="kfgc__variantes">
      <div class="kfgc__var" style="--kfgc-linea: #5f6b38;">
        <img src="PEGA_AQUI_URL_VARIANTE_VERDE" alt="Estuche color verde" width="380" height="300" loading="lazy">
        <span class="kfgc__nombre">Verde</span>
      </div>
      <div class="kfgc__var" style="--kfgc-linea: #b25a1f;">
        <img src="PEGA_AQUI_URL_VARIANTE_NARANJA" alt="Estuche color naranja" width="380" height="300" loading="lazy">
        <span class="kfgc__nombre">Naranja</span>
      </div>
    </div>

    <!-- ===== TARJETAS (lo que va en <strong> sale en negrita) ===== -->
    <div class="kfgc__tarjetas">
      <div class="kfgc__card">
        <div class="kfgc__foto">
          <img src="PEGA_AQUI_URL_TARJETA_ESTILO" alt="Audífonos junto a una radio vintage" width="506" height="412" loading="lazy">
        </div>
        <div class="kfgc__cuerpo">
          <h3 class="kfgc__card-titulo">Estilo.</h3>
          <p class="kfgc__card-texto"><strong>Un diseño único que te acompaña</strong> todos los días.</p>
        </div>
      </div>
      <div class="kfgc__card">
        <div class="kfgc__foto">
          <img src="PEGA_AQUI_URL_TARJETA_CALIDAD" alt="Estuche verde de materiales premium" width="514" height="412" loading="lazy">
        </div>
        <div class="kfgc__cuerpo">
          <h3 class="kfgc__card-titulo">Calidad.</h3>
          <p class="kfgc__card-texto"><strong>Materiales premium, pensados para</strong> durar.</p>
        </div>
      </div>
    </div>

  </div>
</section>
