        },
        "pregunta_2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tarda en llegar mi pedido?",
            "respuesta": "<p>Entre 24 y 48 horas en la mayoría de zonas de Guatemala.</p>"
          }
        },
        "pregunta_3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo pago?",
            "respuesta": "<p>Contraentrega. Pagás directo al mensajero cuando recibís tu pedido — nada por adelantado.</p>"
          }
        },
        "pregunta_4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué pasa si mi pedido llega dañado?",
            "respuesta": "<p>Te lo reponemos sin costo. Escribinos por WhatsApp con tu número de pedido.</p>"
          }
        },
        "pregunta_5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Reemplaza el cepillado normal?",
            "respuesta": "<p>No, lo complementa. Funciona mejor como parte de tu rutina diaria de cepillado, no como reemplazo.</p>"
          }
        },
        "pregunta_6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Contiene alcohol?",
            "respuesta": "<p>No. Es una fórmula sin alcohol, apta para uso diario.</p>"
          }
        }
