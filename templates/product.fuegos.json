      "blocks": {
        "pregunta_1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuántas luces tiene y cuánto mide?",
            "respuesta": "<p>Tiene <strong>600 luces</strong> repartidas en <strong>6 espigas</strong>. El cable mide <strong>3 metros</strong> de largo y la caída de luz es de unos <strong>45 cm</strong>.</p>"
          }
        },
        "pregunta_2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo se conecta?",
            "respuesta": "<p>Se conecta a la <strong>corriente (110 V)</strong>. Consume solo 6 W.</p>"
          }
        },
        "pregunta_3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo cambio los modos de luz?",
            "respuesta": "<p>Con el <strong>control remoto</strong>. Tiene entre 6 y 8 modos de iluminación.</p>"
          }
        },
        "pregunta_4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Se calienta?",
            "respuesta": "<p>No se sobrecalienta: es seguro al tacto y da una luz suave que no deslumbra.</p>"
          }
        },
        "pregunta_5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Puedo darle la forma que quiera?",
            "respuesta": "<p>Sí. Las espigas de alambre se doblan fácil: en estallido de fuegos artificiales, en ramo de flores o como quieras.</p>"
          }
        },
        "pregunta_6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Me llega antes de Navidad?",
            "respuesta": "<p>Si haces tu pedido ahora, sí. El envío es <strong>gratis a toda Colombia</strong>.</p>"
          }
        },
        "pregunta_7": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo pago?",
            "respuesta": "<p>Pagas en efectivo cuando la recibes. No pagas nada por adelantado.</p>"
          }
        }
      },
