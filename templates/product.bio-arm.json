      "blocks": {
        "pregunta_1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Carlos de Mixco pregunta: ¿es peligroso?",
            "respuesta": "<p>Es un juguete para usar con cuidado: <strong>usalo con lentes de protección y nunca apuntés a la cara</strong> de nadie. Las gomas de hidrogel <strong>no se comen</strong>: guardalas lejos de niños pequeños y mascotas.</p>"
          }
        },
        "pregunta_2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Andrea de Villa Nueva pregunta: ¿para qué edad es?",
            "respuesta": "<p>La caja indica <strong>14 años en adelante</strong>. Si es para alguien menor, que juegue siempre con un adulto cerca.</p>"
          }
        },
        "pregunta_3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Luis de Quetzaltenango pregunta: ¿qué pasa cuando se acaban las gomas?",
            "respuesta": "<p>Trae <strong>300 gomas</strong> para empezar. Cuando se acaben, podés pedirnos otro tarro de 300 por Q35.</p>"
          }
        },
        "pregunta_4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "María de Escuintla pregunta: ¿llega antes de Navidad?",
            "respuesta": "<p>Entregamos de <strong>1 a 4 días</strong>. Si pedís antes del 20 de diciembre, te llega antes del 24.</p>"
          }
        },
        "pregunta_5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Jorge de Cobán pregunta: ¿cómo se carga?",
            "respuesta": "<p>Es <strong>recargable por USB</strong>: lo conectás, lo dejás cargar y listo. No gasta pilas.</p>"
          }
        },
        "pregunta_6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Sofía de Antigua pregunta: ¿qué cubre la garantía?",
            "respuesta": "<p>Tenés <strong>60 días de garantía por daños de fábrica</strong>. Escribinos por WhatsApp y te ayudamos.</p>"
          }
        },
        "pregunta_7": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Ana de Huehuetenango pregunta: ¿cómo pago?",
            "respuesta": "<p>Pagás en efectivo cuando lo recibís. El <strong>envío es gratis</strong> y no pagás nada por adelantado.</p>"
          }
        }
      },
      "block_order": [
        "pregunta_1",
