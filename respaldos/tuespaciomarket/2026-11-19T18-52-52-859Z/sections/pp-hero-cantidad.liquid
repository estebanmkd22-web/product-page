{%- comment -%}
  PP · Hero + Cantidad
  Galería, titular, fila de precio (cambia según el pack), estrellas,
  subtítulo, beneficios, selector de cantidad en tarjetas, botón con el
  precio del pack elegido y caja de etiquetas (envío, descuento, garantía).
  Sección propia: no cambia PP · Hero + Oferta ni las otras landings.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

{%- assign p = section.settings.producto | default: product -%}
{%- assign variante = p.selected_or_first_available_variant -%}
{%- assign packs = section.blocks | where: 'type', 'pack' -%}
{%- assign pack_ini = packs.first -%}
{%- for b in packs -%}{%- if b.settings.preseleccionado -%}{%- assign pack_ini = b -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- assign imagenes = '' -%}
{%- for i in (1..6) -%}
{%- assign key = 'imagen_' | append: i -%}
{%- if section.settings[key] != blank -%}
{%- assign imagenes = imagenes | append: key | append: ',' -%}
{%- endif -%}
{%- endfor -%}
{%- assign imagenes = imagenes | split: ',' -%}

<style>
  #pp-hero-{{ section.id }} { background: {{ section.settings.fondo }}; }
  .pp-hero { padding: 0 0 36px; }
  .pp-hero__grid { display: grid; gap: 20px; }
  .pp-hero__media { margin: 0 -16px; position: relative; }
  .pp-hero__slides {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .pp-hero__slides::-webkit-scrollbar { display: none; }
  .pp-hero__slide { flex: 0 0 100%; scroll-snap-align: center; aspect-ratio: {{ section.settings.proporcion }}; background: var(--pp-fondo-2); }
  .pp-hero__slide img { width: 100%; height: 100%; object-fit: cover; }
  .pp-hero__dots { display: flex; justify-content: center; gap: 6px; padding-top: 10px; }
  .pp-hero__dots button {
    width: 7px; height: 7px; padding: 0; border: 0; border-radius: 99px;
    background: var(--pp-borde); cursor: pointer; transition: width .2s, background .2s;
  }
  .pp-hero__dots button[aria-current="true"] { width: 20px; background: var(--pp-texto); }
  .pp-hero__thumbs-wrap { display: flex; align-items: center; gap: 4px; padding: 10px 16px 0; }
  .pp-hero__thumbs { flex: 1 1 auto; display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding: 2px; }
  .pp-hero__thumbs::-webkit-scrollbar { display: none; }
  .pp-hero__thumb {
    flex: 0 0 calc((100% - 32px) / 5); aspect-ratio: 1 / 1; padding: 0; overflow: hidden; scroll-snap-align: start;
    border: 2px solid transparent; border-radius: 8px; background: var(--pp-fondo-2); cursor: pointer; opacity: .7;
    transition: border-color .2s, opacity .2s;
  }
  .pp-hero__thumb img, .pp-hero__thumb svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pp-hero__thumb[aria-current="true"] { border-color: var(--pp-texto); opacity: 1; }
  .pp-hero__tflecha {
    flex: 0 0 26px; height: 40px; padding: 0; border: 0; background: none; color: var(--pp-texto);
    font: 400 26px/1 Arial, sans-serif; cursor: pointer;
  }

  .pp-hero__info { display: flex; flex-direction: column; gap: 14px; }
  .pp-hero__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .pp-hero__title { font-size: clamp(28px, 7.4vw, 44px); }
  .pp-hero__text { font-size: 16px; }
  .pp-hero__zonas p { margin: 0 0 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--pp-texto-2); }
  .pp-hero__zonas ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .pp-hero__zonas li { padding: 6px 12px; border: 1px solid color-mix(in srgb, var(--pp-acento) 35%, transparent); border-radius: 99px; background: color-mix(in srgb, var(--pp-acento) 8%, var(--pp-fondo)); color: var(--pp-acento); font-size: 13px; font-weight: 700; }
  .pp-hero__bens { display: grid; gap: 6px; font-size: 15px; font-weight: 600; }
  .pp-hero__bens li { display: flex; align-items: flex-start; gap: 8px; }
  .pp-hero__bens li.pp-hero__ben--ico::before { content: none; }
  .pp-hero__ico { display: inline-grid; place-items: center; color: var(--pp-acento); font-size: 20px; line-height: 1; }
  .pp-hero__bens li::before {
    content: "{{ section.settings.icono_beneficios }}"; flex: 0 0 auto;
    color: var(--pp-acento); font-weight: 900; line-height: 1.5;
  }

  .pp-offer {
    margin-top: 6px; padding: 18px 16px;
    border: 1.5px solid var(--pp-acento); border-radius: var(--pp-radio);
    background: var(--pp-fondo);
  }
  .pp-offer__price { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .pp-offer__now { font-size: 36px; font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  .pp-offer__before { font-size: 20px; font-weight: 600; color: var(--pp-texto-2); text-decoration: line-through; }
  .pp-offer__save {
    padding: 5px 9px; border-radius: 6px; background: var(--pp-acento); color: #fff;
    font-size: 12px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase;
  }
  .pp .pp-offer__inc-title { margin: 18px 0 4px; font-size: 14px; font-weight: 600; }
  .pp-offer__list li {
    display: flex; gap: 10px; padding: 9px 0; font-size: 14px;
    border-top: 1px solid var(--pp-borde);
  }
  .pp-offer__list li:first-child { border-top: 0; }
  .pp-offer__list li::before { content: "✓"; color: var(--pp-ok); font-weight: 900; }
  .pp-offer__cta { margin-top: 14px; }
  .pp .pp-offer__note { margin-top: 10px; font-size: 13px; text-align: center; color: var(--pp-texto-2); }
  .pp-hero__trans { display: grid; gap: 10px; padding: 14px; border-radius: var(--pp-radio); background: var(--pp-fondo-2); font-size: 15px; }
  .pp-hero__trans li { display: flex; align-items: flex-start; gap: 10px; }
  .pp-hero__trans b { color: var(--pp-acento); }
  .pp .pp-offer__entrega { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 10px; font-size: 14px; color: var(--pp-texto-2); }
  .pp-offer__entrega .pp-ico { font-size: 18px; color: var(--pp-acento); }
  .pp-offer__pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 12px; }
  .pp-offer__pay svg { width: 38px; height: 24px; }
  .pp-offer__pay span {
    padding: 4px 8px; border: 1px solid var(--pp-borde); border-radius: 6px;
    font-size: 11px; font-weight: 700; color: var(--pp-texto-2);
  }

  .pp-hc__price { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .pp-hc__now { font-size: 30px; font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  .pp-hc__before { font-size: 18px; font-weight: 600; color: var(--pp-texto-2); text-decoration: line-through; }
  .pp-hc__save { padding: 5px 10px; border-radius: 6px; background: var(--pp-fondo-2); color: var(--pp-texto); font-size: 13px; font-weight: 700; }
  .pp-hc__save[hidden], .pp-hc__before[hidden] { display: none; }
  .pp-hero__sub { font-size: 17px; line-height: 1.4; }
  .pp-hc__sel { display: grid; gap: 10px; margin-top: 4px; }
  .pp .pp-hc__sel-label { margin: 0; font-size: 14px; color: var(--pp-texto-2); }
  .pp-hc__sel-label b { color: var(--pp-texto); }
  .pp-hc__cards { display: grid; grid-template-columns: repeat(var(--n, 2), 1fr); gap: 10px; }
  .pp-hc__card { position: relative; display: grid; gap: 4px; justify-items: center; padding: 16px 8px 12px; border: 2px solid var(--pp-borde); border-radius: var(--pp-radio); background: var(--pp-fondo); cursor: pointer; text-align: center; transition: border-color .2s, background .2s; }
  .pp-hc__card input { position: absolute; opacity: 0; pointer-events: none; }
  .pp-hc__card.is-activo { border-color: var(--pp-acento); background: color-mix(in srgb, var(--pp-acento) 7%, var(--pp-fondo)); }
  .pp-hc__card-name { font-size: 15px; font-weight: 600; }
  .pp-hc__card-price { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 2px 6px; }
  .pp-hc__card-price b { font-size: 18px; font-weight: 900; }
  .pp-hc__card-price s { font-size: 13px; color: var(--pp-texto-2); }
  .pp-hc__card-tag { font-size: 12px; color: var(--pp-texto-2); line-height: 1.3; }
  .pp-hc__badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); padding: 3px 10px; border-radius: 99px; background: var(--pp-acento); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap; }
  .pp-hc__btn s { opacity: .7; font-weight: 600; font-size: .85em; margin-left: 4px; }
  .pp .pp-hc__nota { margin: 0; font-size: 13px; text-align: center; color: var(--pp-texto-2); }
  .pp-hc__etqs { display: grid; gap: 10px; padding: 14px 16px; border: 1.5px dashed color-mix(in srgb, var(--pp-acento) 45%, transparent); border-radius: var(--pp-radio); background: var(--pp-fondo-2); }
  .pp .pp-hc__etqs-title { margin: 0; font-size: 15px; font-weight: 800; }
  .pp-hc__etqs li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; }
  .pp-hc__etqs .pp-hero__ico { font-size: 20px; }

  @media (min-width: 900px) {
    .pp-hero { padding: 40px 0 64px; }
    .pp-hero__grid { grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: start; }
    .pp-hero__media { margin: 0; position: sticky; top: 24px; }
    .pp-hero__slide, .pp-hero__slide img { border-radius: var(--pp-radio); }
    .pp-hero__slides { gap: 12px; }
  }
</style>

{%- if section.settings.tamano_titulo != blank -%}
<style>
  #pp-hero-{{ section.id }} .pp-hero__title { font-size: {{ section.settings.tamano_titulo }}px; }
  @media (min-width: 750px) { #pp-hero-{{ section.id }} .pp-hero__title { font-size: {{ section.settings.tamano_titulo | times: 1.4 | round }}px; } }
</style>
{%- endif -%}
<div id="pp-hero-{{ section.id }}" class="pp pp-hero">
  <div class="pp-wrap pp-hero__grid">

    {%- comment -%} ===== Galería ===== {%- endcomment -%}
    <div class="pp-hero__media">
      <div class="pp-hero__slides" data-pp-slides>
        {%- if imagenes.size > 0 -%}
          {%- for key in imagenes -%}
            {%- assign img = section.settings[key] -%}
            {%- assign alt = img.alt | default: p.title -%}
            <div class="pp-hero__slide">
              {%- if forloop.first -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200', alt: alt }}
              {%- else -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200', alt: alt }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for media in p.media limit: 6 -%}
            <div class="pp-hero__slide">
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200' }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="pp-hero__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if section.settings.navegacion == 'miniaturas' -%}
        <div class="pp-hero__thumbs-wrap">
          <button type="button" class="pp-hero__tflecha" aria-label="Imagen anterior" data-pp-tprev>&lsaquo;</button>
          <div class="pp-hero__thumbs" data-pp-thumbs>
            {%- if imagenes.size > 0 -%}
              {%- for key in imagenes -%}
                <button type="button" class="pp-hero__thumb" aria-label="Ver imagen {{ forloop.index }}">{{ section.settings[key] | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}</button>
              {%- endfor -%}
            {%- else -%}
              {%- for media in p.media limit: 6 -%}
                <button type="button" class="pp-hero__thumb" aria-label="Ver imagen {{ forloop.index }}">{{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}</button>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <button type="button" class="pp-hero__tflecha" aria-label="Imagen siguiente" data-pp-tnext>&rsaquo;</button>
        </div>
      {%- else -%}
        <div class="pp-hero__dots" data-pp-dots></div>
      {%- endif -%}
    </div>

    {%- comment -%} ===== Información y oferta ===== {%- endcomment -%}
    <div class="pp-hero__info">
      {%- if section.settings.titulo != blank -%}
        <h1 class="pp-h pp-hero__title">{{ section.settings.titulo }}</h1>
      {%- endif -%}

      {%- if pack_ini -%}
        {%- assign pi = pack_ini.settings.precio | times: 100 -%}
        {%- assign pa = pack_ini.settings.precio_antes | default: 0 | times: 100 -%}
        <div class="pp-hc__price">
          <span class="pp-hc__now" data-pp-hc-now>{{ pi | money_without_trailing_zeros }}</span>
          <span class="pp-hc__before" data-pp-hc-before{% unless pa > pi %} hidden{% endunless %}>{{ pa | money_without_trailing_zeros }}</span>
          <span class="pp-hc__save" data-pp-hc-save{% unless pa > pi %} hidden{% endunless %}>{{ section.settings.ahorro_texto }} <span data-pp-hc-save-val>{{ pa | minus: pi | money_without_trailing_zeros }}</span></span>
        </div>
      {%- endif -%}

      {%- if section.settings.mostrar_rating -%}
        <div class="pp-hero__rating">
          <span class="pp-stars" aria-hidden="true">★★★★★</span>
          <span><strong>{{ section.settings.rating }}</strong> <span class="pp-muted">{{ section.settings.rating_texto }}</span></span>
        </div>
      {%- endif -%}

      {%- if section.settings.texto != blank -%}
        <p class="pp-hero__sub">{{ section.settings.texto }}</p>
      {%- endif -%}

      {%- assign bens = section.blocks | where: 'type', 'beneficio' -%}
      {%- if bens.size > 0 -%}
        <ul class="pp-hero__bens">
          {%- for block in bens -%}
            {%- assign icono = block.settings.icono | default: 'ninguno' -%}
            <li class="{% if icono != 'ninguno' %}pp-hero__ben--ico{% endif %}" {{ block.shopify_attributes }}>
              {%- if icono != 'ninguno' -%}<span class="pp-hero__ico">{%- comment -%}PP-ICONOS:START{%- endcomment -%}
{%- case icono -%}
