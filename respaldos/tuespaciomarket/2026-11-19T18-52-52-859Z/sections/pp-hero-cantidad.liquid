<script>
  (function () {
    var root = document.getElementById('pp-hero-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-pp-slides]');
    var dotsBox = root.querySelector('[data-pp-dots]');
    var thumbsBox = root.querySelector('[data-pp-thumbs]');
    var slides = track.children;
    var wrap = thumbsBox && thumbsBox.parentNode;
    if (slides.length < 2) { if (wrap) wrap.style.display = 'none'; return; }
    var actual = 0;
    function ir(n) {
      n = (n + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    }
    var marcas = [];
    if (thumbsBox) {
      marcas = Array.prototype.slice.call(thumbsBox.children);
      marcas.forEach(function (t, j) { t.addEventListener('click', function () { ir(j); }); });
      root.querySelector('[data-pp-tprev]').addEventListener('click', function () { ir(actual - 1); });
      root.querySelector('[data-pp-tnext]').addEventListener('click', function () { ir(actual + 1); });
    } else if (dotsBox) {
      for (var i = 0; i < slides.length; i++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', 'Imagen ' + (i + 1));
        b.addEventListener('click', (function (n) { return function () { ir(n); }; })(i));
        dotsBox.appendChild(b);
        marcas.push(b);
      }
    }
    function marcar() {
      var n = Math.round(track.scrollLeft / track.clientWidth);
      if (n === actual && marcas[n] && marcas[n].getAttribute('aria-current') === 'true') return;
      actual = n;
      marcas.forEach(function (d, j) { d.setAttribute('aria-current', j === n ? 'true' : 'false'); });
      if (thumbsBox && marcas[n]) {
        var t = marcas[n];
        var izq = t.offsetLeft - thumbsBox.offsetLeft - (thumbsBox.clientWidth - t.clientWidth) / 2;
        thumbsBox.scrollTo({ left: izq, behavior: 'smooth' });
      }
    }
    track.addEventListener('scroll', function () { window.requestAnimationFrame(marcar); }, { passive: true });
    marcar();
  })();

  (function () {
    var root = document.getElementById('pp-hero-{{ section.id }}');
    if (!root) return;
    var radios = root.querySelectorAll('.pp-hc__card input');
    if (!radios.length) return;
    function q(s) { return root.querySelector(s); }
    var now = q('[data-pp-hc-now]'), before = q('[data-pp-hc-before]'), save = q('[data-pp-hc-save]'), saveVal = q('[data-pp-hc-save-val]');
    var nombre = q('[data-pp-hc-nombre]'), btnPrecio = q('[data-pp-hc-btn-precio]'), btnAntes = q('[data-pp-hc-btn-antes]'), cantidad = q('[data-pp-hc-cantidad]');
    function aplicar() {
      radios.forEach(function (r) {
        r.parentNode.classList.toggle('is-activo', r.checked);
        if (!r.checked) return;
        var d = r.dataset;
        if (now) now.textContent = d.precio;
        if (before) { before.textContent = d.antes; before.hidden = !d.antes; }
        if (save) { save.hidden = !d.ahorro; if (saveVal) saveVal.textContent = d.ahorro; }
        if (nombre) nombre.textContent = d.nombre;
        if (btnPrecio) btnPrecio.textContent = d.precio;
        if (btnAntes) btnAntes.textContent = d.antes;
        if (cantidad) cantidad.value = d.cantidad;
      });
    }
    radios.forEach(function (r) { r.addEventListener('change', aplicar); });
    aplicar();
  })();
</script>

