              <input type="hidden" name="quantity" value="{{ pack_ini.settings.cantidad | default: 1 }}" data-pp-hc-cantidad>
              {%- if section.settings.ir_a_checkout -%}<input type="hidden" name="return_to" value="/checkout">{%- endif -%}
              <button type="submit" class="pp-btn pp-hc__btn{{ pulse }}"{% unless variante.available %} disabled{% endunless %}>{{ boton_contenido }}</button>
            {%- endform -%}
          {%- else -%}
            <a href="{{ section.settings.boton_enlace | default: '#' }}" class="pp-btn pp-hc__btn{{ pulse }}">{{ boton_contenido }}</a>
        {%- endcase -%}
