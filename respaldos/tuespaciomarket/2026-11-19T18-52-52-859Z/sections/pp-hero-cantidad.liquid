            {%- assign bp = block.settings.precio | times: 100 -%}
            {%- assign ba = block.settings.precio_antes | default: 0 | times: 100 -%}
            <label class="pp-hc__card{% if block.id == pack_ini.id %} is-activo{% endif %}" {{ block.shopify_attributes }}>
              <input type="radio" name="pp-hc-{{ section.id }}"{% if block.id == pack_ini.id %} checked{% endif %}
                data-nombre="{{ block.settings.nombre | escape }}"
                data-precio="{{ bp | money_without_trailing_zeros | escape }}"
                data-antes="{% if ba > bp %}{{ ba | money_without_trailing_zeros | escape }}{% endif %}"
                data-ahorro="{% if ba > bp %}{{ ba | minus: bp | money_without_trailing_zeros | escape }}{% endif %}"
                data-cantidad="{{ block.settings.cantidad | default: 1 }}">
              {%- if block.settings.destacar != blank -%}<span class="pp-hc__badge">{{ block.settings.destacar }}</span>{%- endif -%}
              <span class="pp-hc__card-name">{{ block.settings.nombre }}</span>
              <span class="pp-hc__card-price"><b>{{ bp | money_without_trailing_zeros }}</b>{% if ba > bp %}<s>{{ ba | money_without_trailing_zeros }}</s>{% endif %}</span>
              {%- if block.settings.etiqueta != blank -%}<span class="pp-hc__card-tag">{{ block.settings.etiqueta }}</span>{%- endif -%}
            </label>
          {%- endfor -%}
        </div>

