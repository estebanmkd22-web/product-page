    "faq": {
      "type": "pp-faq",
      "blocks": {
        "pregunta_1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Andrés de Bogotá pregunta: ¿este también se va a mover solo?",
            "respuesta": "<p>No te vamos a prometer que nunca falle. Lo que sí te damos: <strong>90 días de garantía con devolución del dinero</strong>, y lo pagas al recibir.</p>"
          }
        },
        "pregunta_2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Marta de Medellín pregunta: ¿es original de Nintendo?",
            "respuesta": "<p>No. Es un control <strong>compatible con Nintendo Switch</strong>, sin marca. Tiene vibración, sensor de movimiento, lector de figuras amiibo y batería de hasta 40 horas.</p>"
          }
        },
        "pregunta_3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Camilo de Cali pregunta: ¿sirve con mi consola?",
            "respuesta": "<p>Sí, si es una <strong>Switch, Switch Lite, Switch OLED o Switch 2</strong>. Se conecta por Bluetooth desde el menú Controles.</p>"
          }
        },
        "pregunta_4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Julián de Barranquilla pregunta: ¿tiene vibración, sensor de movimiento y lee amiibo?",
            "respuesta": "<p>Sí, las tres: <strong>vibración HD</strong>, giroscopio para apuntar moviendo el control y <strong>NFC para figuras amiibo</strong>, que muchos compatibles no traen.</p>"
          }
        },
        "pregunta_5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Sebastián de Bucaramanga pregunta: ¿se desconecta o es difícil de conectar?",
            "respuesta": "<p>Se conecta por Bluetooth desde el menú Controles de la consola. Si en algún momento se desconecta, sigues jugando con el cable. Y tienes <strong>90 días de garantía con devolución del dinero</strong>.</p>"
          }
        },
        "pregunta_6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Laura de Pereira pregunta: ¿cuánto dura la batería?",
            "respuesta": "<p>Hasta <strong>40 horas de juego</strong> por carga. Se carga completo en unas 6 horas con el cable USB-C que viene en la caja.</p>"
          }
        },
        "pregunta_7": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Diego de Cartagena pregunta: ¿prende la consola con el botón Home?",
            "respuesta": "<p>No lo prometemos. Prende la consola con su botón y después juega normal con el control.</p>"
          }
        },
        "pregunta_8": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Paola de Ibagué pregunta: ¿por qué cuesta más que otros controles compatibles?",
            "respuesta": "<p>Porque trae lo que más se usa del control de marca: vibración, sensor de movimiento, lector de figuras amiibo y hasta 40 horas de batería. Además, la garantía es <strong>aquí en Colombia</strong>: 90 días de garantía con devolución del dinero, y lo pagas al recibir. El de marca cuesta $339.900.</p>"
          }
        },
        "pregunta_9": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Sandra de Villavicencio pregunta: ¿cómo pago y hasta cuándo es el precio de Black Days?",
            "respuesta": "<p>Pagas cuando lo recibes y el envío es <strong>gratis a toda Colombia</strong>. El precio de Black Days, $179.900, va <strong>hasta el 30 de noviembre</strong>. Y al hacer tu pedido te damos un <strong>15 % de descuento para tu segundo control</strong>.</p>"
          }
        },
        "pregunta_10": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Mateo de Manizales pregunta: ¿sirve para todos los juegos?",
            "respuesta": "<p>Está pensado para <strong>carreras, acción y aventuras</strong>, donde más se nota el agarre y los sticks grandes. No te prometemos que sirva igual en todos: algunos juegos están hechos para jugar con los controlcitos separados.</p>"
          }
        }
