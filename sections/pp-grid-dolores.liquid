{%- comment -%}
  PP · Grid de dolores
  Titular + tarjetas con imagen, título corto y texto, en 2 columnas.
  Cierre opcional con una frase grande (ej: "Y todo esto se va acumulando").
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

<style>
  #pp-dolores-{{ section.id }} .pp-dolores__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columnas_movil }}, minmax(0, 1fr));
    gap: 24px 14px;
  }
  #pp-dolores-{{ section.id }} .pp-img { aspect-ratio: {{ section.settings.proporcion }}; margin-bottom: 10px; }
  .pp-dolores__item h3 {
    margin-bottom: 4px;
    font-size: 14px; font-weight: 800; line-height: 1.25;
    letter-spacing: .03em; text-transform: uppercase; color: var(--pp-acento);
  }
  .pp-dolores__item p { font-size: 14px; color: var(--pp-texto-2); }
  .pp-bg--oscuro .pp-dolores__item p { color: inherit; opacity: .8; }
  .pp .pp-dolores__cierre {
    margin-top: 32px; text-align: center;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(22px, 5.6vw, 32px); font-weight: 800; line-height: 1.15;
  }
  .pp-dolores__cierre em { font-style: normal; color: var(--pp-acento); }
  @media (min-width: 750px) {
    #pp-dolores-{{ section.id }} .pp-dolores__grid { grid-template-columns: repeat({{ section.settings.columnas_pc }}, minmax(0, 1fr)); gap: 32px 24px; }
  }
</style>

<div id="pp-dolores-{{ section.id }}" class="pp pp-section pp-bg--{{ section.settings.fondo }}">
  <div class="pp-wrap">
    <div class="pp-head">
      {%- if section.settings.etiqueta != blank -%}<p class="pp-eyebrow">{{ section.settings.etiqueta }}</p>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    <div class="pp-dolores__grid">
      {%- for block in section.blocks -%}
        <div class="pp-dolores__item" {{ block.shopify_attributes }}>
          <div class="pp-img">
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 750px) 360px, 50vw' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          {%- if block.settings.titulo != blank -%}<h3>{{ block.settings.titulo }}</h3>{%- endif -%}
          {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cierre != blank -%}
      <p class="pp-dolores__cierre">{{ section.settings.cierre }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PP · Grid de dolores",
  "tag": "section",
  "class": "pp-dolores-section",
  "settings": [
    {
      "type": "select", "id": "fondo", "label": "Fondo", "default": "fondo",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" },
        { "value": "oscuro", "label": "Oscuro" }
      ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña (opcional)" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular (la cursiva sale en color de acento)", "default": "Lo que <em>no limpias</em>, también cuenta." },
    { "type": "inline_richtext", "id": "texto", "label": "Texto", "default": "Cada día pueden quedar residuos y acumulación en tu boca que tu rutina habitual no elimina por completo." },
    {
      "type": "select", "id": "columnas_movil", "label": "Columnas en celular", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ]
    },
    {
      "type": "select", "id": "columnas_pc", "label": "Columnas en computador", "default": "4",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ]
    },
    {
      "type": "select", "id": "proporcion", "label": "Formato de las imágenes", "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Cuadrado (1:1)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "4 / 3", "label": "Horizontal (4:3)" }
      ]
    },
    { "type": "inline_richtext", "id": "cierre", "label": "Frase de cierre (opcional, sale grande)", "default": "Y todo esto <em>se va acumulando.</em>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen" },
        { "type": "text", "id": "titulo", "label": "Título corto", "default": "Residuos que se quedan" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Pequeños restos de comida pueden permanecer adheridos y acumularse durante el día." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Grid de dolores",
      "blocks": [
        { "type": "item", "settings": { "titulo": "Residuos que se quedan", "texto": "Pequeños restos de comida pueden permanecer adheridos y acumularse durante el día." } },
        { "type": "item", "settings": { "titulo": "Aliento que no se va", "texto": "La acumulación de residuos y bacterias puede contribuir al mal aliento." } },
        { "type": "item", "settings": { "titulo": "Una lengua que también acumula", "texto": "La lengua puede acumular bacterias, proteínas y residuos que forman parte de la higiene oral diaria." } },
        { "type": "item", "settings": { "titulo": "Esa sensación de \"algo queda\"", "texto": "Aunque te cepilles, puedes seguir sintiendo que tu boca no está completamente limpia." } }
      ]
    }
  ]
}
{% endschema %}
