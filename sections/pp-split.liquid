{%- comment -%}
  PP · Imagen + texto (split)
  Foto a un lado y panel de color al otro con etiqueta, título grande,
  texto, puntos en 2 columnas y botón (ej: "Seamos honestos").
{%- endcomment -%}
<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>
<style>
  #pp-sp-{{ section.id }} {
    --sp-bg: {{ section.settings.color_fondo }}; --sp-tx: {{ section.settings.color_texto }}; --sp-ac: {{ section.settings.color_acento }};
    --sp-btn: {{ section.settings.color_boton }}; --sp-btn-tx: {{ section.settings.color_boton_texto }};
    display: grid; background: var(--sp-bg); color: var(--sp-tx);
  }
  .pp-sp__foto { position: relative; aspect-ratio: {{ section.settings.proporcion_movil }}; overflow: hidden; background: color-mix(in srgb, var(--sp-tx) 10%, var(--sp-bg)); }
  .pp-sp__foto img, .pp-sp__foto svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pp-sp__panel { display: grid; align-content: center; padding: 34px 20px 40px; }
  .pp-sp__in { max-width: 520px; }
  .pp-sp__eyebrow { margin: 0 0 10px; color: var(--sp-ac); font-size: 12px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  #pp-sp-{{ section.id }} .pp-sp__titulo { margin: 0; color: var(--sp-tx); font-size: clamp(32px, 9vw, 54px); line-height: .98; text-transform: {% if section.settings.mayusculas %}uppercase{% else %}none{% endif %}; }
  #pp-sp-{{ section.id }} .pp-sp__titulo em { color: var(--sp-ac); font-style: normal; }
  .pp-sp__texto { margin: 16px 0 0; font-size: clamp(15px, 4vw, 17px); line-height: 1.6; opacity: .88; }
  .pp-sp__puntos { display: grid; gap: 10px 22px; margin: 20px 0 0; padding: 0; list-style: none; }
  .pp-sp__puntos li { position: relative; padding-left: 16px; font-size: 14.5px; font-weight: 700; line-height: 1.35; }
  .pp-sp__puntos li::before { content: ""; position: absolute; left: 0; top: .5em; width: 6px; height: 6px; border-radius: 50%; background: var(--sp-ac); }
  .pp-sp__cta { margin-top: 26px; }
  #pp-sp-{{ section.id }} .pp-sp__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 14px 26px; border-radius: 6px; background: var(--sp-btn); color: var(--sp-btn-tx); font-size: 14px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; }
  @media (max-width: 749px) { #pp-sp-{{ section.id }} .pp-sp__btn { width: 100%; } }
  @media (min-width: 750px) {
    #pp-sp-{{ section.id }} { grid-template-columns: 1fr 1fr; }
    .pp-sp__foto { aspect-ratio: auto; min-height: 520px; }
    .pp-sp--der .pp-sp__foto { order: 2; }
    .pp-sp__panel { padding: 56px clamp(28px, 6vw, 96px); }
    .pp-sp__puntos { grid-template-columns: 1fr 1fr; }
  }
</style>
<div id="pp-sp-{{ section.id }}" class="pp pp-sp{% if section.settings.posicion == 'der' %} pp-sp--der{% endif %}">
  <div class="pp-sp__foto">
    {%- if section.settings.imagen != blank -%}
      {{ section.settings.imagen | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.etiqueta }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="pp-sp__panel">
    <div class="pp-sp__in">
      {%- if section.settings.etiqueta != blank -%}<p class="pp-sp__eyebrow">{{ section.settings.etiqueta }}</p>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-sp__titulo">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-sp__texto">{{ section.settings.texto }}</p>{%- endif -%}
      {%- if section.settings.puntos != blank -%}
        {%- assign puntos = section.settings.puntos | newline_to_br | split: '<br />' -%}
        <ul class="pp-sp__puntos">
          {%- for p in puntos -%}{%- assign pt = p | strip -%}{%- if pt != blank -%}<li>{{ pt }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.boton_modo != 'ninguno' -%}
        <div class="pp-sp__cta">
          {%- case section.settings.boton_modo -%}
            {%- when 'easysell' -%}
              <a href="javascript:void(0);" class="es-popup-button-overwrite pp-sp__btn">{{ section.settings.boton_texto }}</a>
            {%- when 'oferta' -%}
              <a href="#oferta" class="pp-sp__btn" data-pp-sp-oferta>{{ section.settings.boton_texto }}</a>
            {%- else -%}
              <a href="{{ section.settings.boton_enlace | default: '#' }}" class="pp-sp__btn">{{ section.settings.boton_texto }}</a>
          {%- endcase -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('pp-sp-{{ section.id }}');
    var btn = root && root.querySelector('[data-pp-sp-oferta]');
    if (!btn) return;
    btn.addEventListener('click', function (ev) {
      var destino = document.getElementById('oferta') || document.querySelector('.pp-of, [data-pp-oferta]');
      if (!destino) return;
      ev.preventDefault();
      destino.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

{% schema %}
{
  "name": "PP · Imagen + texto",
  "tag": "section",
  "class": "pp-split-section",
  "settings": [
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo del panel", "default": "#141414" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#ffffff" },
    { "type": "color", "id": "color_acento", "label": "Acento (etiqueta, puntos, palabra destacada)", "default": "#e3242b" },
    { "type": "color", "id": "color_boton", "label": "Fondo del botón", "default": "#e3242b" },
    { "type": "color", "id": "color_boton_texto", "label": "Texto del botón", "default": "#ffffff" },
    { "type": "header", "content": "Foto" },
    { "type": "image_picker", "id": "imagen", "label": "Foto (sin texto)" },
    {
      "type": "select", "id": "posicion", "label": "Foto en computador", "default": "izq",
      "options": [ { "value": "izq", "label": "A la izquierda" }, { "value": "der", "label": "A la derecha" } ]
    },
    {
      "type": "select", "id": "proporcion_movil", "label": "Formato de la foto en celular", "default": "1 / 1",
      "options": [ { "value": "1 / 1", "label": "Cuadrado (1:1)" }, { "value": "4 / 5", "label": "Vertical (4:5)" }, { "value": "4 / 3", "label": "Horizontal (4:3)" } ]
    },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "Seamos honestos" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título (cursiva = color de acento)", "default": "Sabes perfectamente de qué estamos hablando." },
    { "type": "checkbox", "id": "mayusculas", "label": "Título en mayúsculas", "default": true },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "textarea", "id": "puntos", "label": "Puntos (uno por línea)" },
    { "type": "header", "content": "Botón" },
    {
      "type": "select", "id": "boton_modo", "label": "¿Qué hace el botón?", "default": "oferta",
      "options": [
        { "value": "ninguno", "label": "Sin botón" },
        { "value": "oferta", "label": "Bajar o subir a los packs" },
        { "value": "easysell", "label": "Abrir formulario EasySell" },
        { "value": "enlace", "label": "Ir a un enlace" }
      ]
    },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Lo quiero" },
    { "type": "url", "id": "boton_enlace", "label": "Enlace (solo si eliges \"Ir a un enlace\")" }
  ],
  "presets": [ { "name": "PP · Imagen + texto" } ]
}
{% endschema %}
