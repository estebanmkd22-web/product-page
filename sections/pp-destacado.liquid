{%- comment -%}
  PP · Destacado
  Titular + texto + lista de puntos (con símbolo o ícono) + imagen.
  Estilo claro (ej: "Menos ruido. Más producto.") o tarjeta oscura con
  firma (ej: "El experto detrás de la fórmula").
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

<style>
  #pp-dest-{{ section.id }} { --dest-c: {{ section.settings.color_tarjeta }}; }
  .pp-dest__caja { display: grid; gap: 22px; max-width: 920px; margin: 0 auto; }
  .pp-dest--tarjeta .pp-dest__caja {
    overflow: hidden; padding: 0 0 28px; border-radius: calc(var(--pp-radio) + 10px);
    background: linear-gradient(140deg, var(--dest-c), color-mix(in srgb, var(--dest-c) 55%, #000)); color: #fff;
  }
  .pp-dest--tarjeta .pp-dest__cuerpo { padding: 0 22px; }
  .pp-dest--tarjeta .pp-dest__cuerpo:first-child { padding-top: 28px; }
  .pp-dest--tarjeta .pp-h, .pp-dest--tarjeta .pp-lead { color: inherit; }
  .pp-dest--tarjeta .pp-lead { opacity: .9; }
  .pp-dest__cuerpo { display: grid; gap: 14px; }
  .pp-dest__lista { display: grid; gap: 18px; margin-top: 10px; }
  .pp-dest__item { display: grid; grid-template-columns: 48px 1fr; gap: 14px; align-items: center; }
  .pp-dest__sim {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--pp-texto); color: var(--pp-acento); font-size: 20px; font-weight: 900;
  }
  .pp-dest--tarjeta .pp-dest__sim { width: 30px; height: 30px; background: rgba(255, 255, 255, .95); color: var(--dest-c); font-size: 16px; }
  .pp-dest--tarjeta .pp-dest__item { grid-template-columns: 30px 1fr; align-items: start; }
  .pp-dest__item h3 { font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
  .pp-dest--tarjeta .pp-dest__item h3 { font-size: 16px; text-transform: none; letter-spacing: 0; font-weight: 600; }
  .pp-dest__item p { margin-top: 2px; font-size: 15px; color: var(--pp-texto-2); }
  .pp-dest--tarjeta .pp-dest__item p { color: inherit; opacity: .85; }
  .pp-dest__img img { width: 100%; height: auto; }
  .pp-dest--claro .pp-dest__img img { border-radius: var(--pp-radio); }
  .pp-dest__firma { display: grid; gap: 2px; margin-top: 6px; }
  .pp-dest__firma strong { font-size: 16px; }
  .pp-dest__firma span { font-size: 14px; opacity: .8; }
  @media (min-width: 750px) {
    .pp-dest__caja--lado { grid-template-columns: 1fr 1fr; align-items: center; gap: 40px; }
    .pp-dest--tarjeta .pp-dest__caja--lado { padding: 0; }
    .pp-dest--tarjeta .pp-dest__caja--lado .pp-dest__cuerpo { padding: 36px 36px 36px 0; }
    .pp-dest__caja--lado .pp-dest__img { height: 100%; }
    .pp-dest__caja--lado .pp-dest__img img { height: 100%; object-fit: cover; }
  }
</style>

{%- assign lado = false -%}
{%- if section.settings.imagen != blank and section.settings.posicion == 'lado' -%}{%- assign lado = true -%}{%- endif -%}

<div id="pp-dest-{{ section.id }}" class="pp pp-section pp-bg--{{ section.settings.fondo }} pp-dest--{{ section.settings.estilo }}">
  <div class="pp-wrap">
    <div class="pp-dest__caja{% if lado %} pp-dest__caja--lado{% endif %}">
      {%- if section.settings.imagen != blank and section.settings.posicion != 'abajo' -%}
        <div class="pp-dest__img">{{ section.settings.imagen | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400, 700, 1100', sizes: '(min-width: 750px) 460px, 100vw' }}</div>
      {%- endif -%}
      <div class="pp-dest__cuerpo">
        {%- if section.settings.etiqueta != blank -%}<p class="pp-eyebrow"{% if section.settings.estilo == 'tarjeta' %} style="color:inherit;opacity:.75"{% endif %}>{{ section.settings.etiqueta }}</p>{%- endif -%}
        {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
        {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="pp-dest__lista">
            {%- for block in section.blocks -%}
              <div class="pp-dest__item" {{ block.shopify_attributes }}>
                <span class="pp-dest__sim" aria-hidden="true">
                  {%- if block.settings.icono != 'ninguno' -%}
                    {%- assign icono = block.settings.icono -%}{%- comment -%}PP-ICONOS:START{%- endcomment -%}
{%- case icono -%}
{%- when 'diente' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3C5 3 3.5 4.6 3.5 7c0 2 1 3.4 1.6 5.4.5 1.7.6 3.6 1 5.6.3 1.6.8 3 1.9 3 1.4 0 1.4-3.6 2-5.4.3-1 .9-1.6 2-1.6s1.7.6 2 1.6c.6 1.8.6 5.4 2 5.4 1.1 0 1.6-1.4 1.9-3 .4-2 .5-3.9 1-5.6.6-2 1.6-3.4 1.6-5.4 0-2.4-1.5-4-3.5-4-1.8 0-2.8 1-5 1S8.8 3 7 3z"/></svg>
{%- when 'escudo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
{%- when 'frescura' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9c3 0 3-2 6-2s3 2 6 2 3-2 6-2M3 15c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/></svg>
{%- when 'hoja' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19C5 11 10 5 20 5c0 10-6 15-14 15"/><path d="M5 19l7-7"/></svg>
{%- when 'sonrisa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 14c1 1.5 2.4 2.2 4 2.2s3-.7 4-2.2M9 9.5h.01M15 9.5h.01"/></svg>
{%- when 'brillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3zM19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z"/></svg>
{%- when 'check' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
{%- when 'reloj' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- when 'gota' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3 4 6 7.5 6 11a6 6 0 01-12 0c0-3.5 3-7 6-11z"/></svg>
{%- when 'calendario' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4M9 15l2 2 4-4"/></svg>
{%- when 'camion' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
{%- when 'pago' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
{%- when 'corazon' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg>
{%- when 'lupa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/></svg>
{%- when 'regalo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zm0 0c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>
{%- when 'chat' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-3.9-1L4 20z"/></svg>
{%- when 'rayo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 13.5h6L10 21l8-10.5h-6L13 3z"/></svg>
{%- when 'bombillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>
{%- when 'usb' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V5"/><path d="M9 6l3-3 3 3"/><path d="M12 15l-4-3V9"/><circle cx="8" cy="8" r="1.4"/><path d="M12 13l4-2.5V8.5"/><path d="M14.8 7h2.4v2.4h-2.4z"/><circle cx="12" cy="20" r="1.4"/></svg>
{%- when 'casa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7"/><path d="M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/></svg>
{%- when 'arbol' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l4 5h-2.5l4 5h-2.5l4 5H5l4-5H6.5l4-5H8l4-5z"/><path d="M12 18v3"/></svg>
{%- when 'estrella' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/></svg>
{%- endcase -%}
{%- comment -%}PP-ICONOS:END{%- endcomment -%}
                  {%- else -%}
                    {{ block.settings.simbolo | default: '✓' }}
                  {%- endif -%}
                </span>
                <div>
                  <h3>{{ block.settings.titulo }}</h3>
                  {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.firma != blank -%}
          <div class="pp-dest__firma"><strong>{{ section.settings.firma }}</strong>{% if section.settings.cargo != blank %}<span>{{ section.settings.cargo }}</span>{% endif %}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.imagen != blank and section.settings.posicion == 'abajo' -%}
        <div class="pp-dest__img">{{ section.settings.imagen | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400, 700, 1100', sizes: '(min-width: 750px) 920px, 100vw' }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PP · Destacado",
  "tag": "section",
  "class": "pp-destacado-section",
  "settings": [
    {
      "type": "select", "id": "estilo", "label": "Estilo", "default": "claro",
      "options": [
        { "value": "claro", "label": "Claro (lista con círculos)" },
        { "value": "tarjeta", "label": "Tarjeta de color (ej: el experto)" }
      ]
    },
    { "type": "color", "id": "color_tarjeta", "label": "Color de la tarjeta", "default": "#1b7a35" },
    {
      "type": "select", "id": "fondo", "label": "Fondo de la sección", "default": "fondo",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" }
      ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "Solo lo esencial" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular (la cursiva sale en color de acento)", "default": "Menos ruido. <em>Más resultados.</em>" },
    { "type": "inline_richtext", "id": "texto", "label": "Texto" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen (opcional)" },
    {
      "type": "select", "id": "posicion", "label": "Posición de la imagen", "default": "abajo",
      "options": [
        { "value": "arriba", "label": "Arriba" },
        { "value": "abajo", "label": "Abajo" },
        { "value": "lado", "label": "Al lado (en computador)" }
      ]
    },
    { "type": "text", "id": "firma", "label": "Firma (opcional, ej: nombre del experto)" },
    { "type": "text", "id": "cargo", "label": "Cargo o descripción de la firma" }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Punto",
      "settings": [
        { "type": "select", "id": "icono", "label": "Ícono", "default": "ninguno", "options": [{"value": "ninguno", "label": "Sin ícono"}, {"value": "diente", "label": "Diente"}, {"value": "escudo", "label": "Escudo"}, {"value": "frescura", "label": "Frescura / aire"}, {"value": "hoja", "label": "Hoja"}, {"value": "sonrisa", "label": "Sonrisa"}, {"value": "brillo", "label": "Brillo"}, {"value": "check", "label": "Check"}, {"value": "reloj", "label": "Reloj"}, {"value": "gota", "label": "Gota"}, {"value": "calendario", "label": "Calendario"}, {"value": "camion", "label": "Camión (envío)"}, {"value": "pago", "label": "Pago / billete"}, {"value": "corazon", "label": "Corazón"}, {"value": "lupa", "label": "Lupa"}, {"value": "regalo", "label": "Regalo"}, {"value": "chat", "label": "WhatsApp / chat"}, {"value": "rayo", "label": "Rayo / energía"}, {"value": "bombillo", "label": "Bombillo / luz"}, {"value": "usb", "label": "USB"}, {"value": "casa", "label": "Casa"}, {"value": "arbol", "label": "Árbol de Navidad"}, {"value": "estrella", "label": "Estrella"}] },
        { "type": "text", "id": "simbolo", "label": "O un símbolo corto (ej: 0, ∅, +)", "default": "✓" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Sin alcohol" },
        { "type": "text", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    { "name": "PP · Destacado", "blocks": [ { "type": "punto" }, { "type": "punto" }, { "type": "punto" } ] }
  ]
}
{% endschema %}
