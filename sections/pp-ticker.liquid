{%- comment -%}
  PP · Barra animada (ticker)
  Franja con mensajes que se desplazan: envío gratis, clientes, garantía…
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   :where() deja estos colores con prioridad mínima, así
   "PP · Estilos globales" siempre los reemplaza. */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

.pp {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.pp img {
  display: block;
  max-width: 100%;
  height: auto;
}

.pp h1,
.pp h2,
.pp h3,
.pp p,
.pp ul {
  margin: 0;
}

.pp ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: usan la fuente de títulos del tema (Dawn) */
.pp-h {
  font-family: var(--font-heading-family, inherit);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}
/* PP-BASE:END */
</style>

{%- liquid
  assign velocidad = section.settings.velocidad
  assign total = section.blocks.size
-%}

<style>
  #pp-ticker-{{ section.id }} {
    --tk-bg: {{ section.settings.fondo }};
    --tk-fg: {{ section.settings.texto }};
    --tk-dur: {{ velocidad }}s;
  }
  .pp-ticker {
    overflow: hidden;
    background: var(--tk-bg);
    color: var(--tk-fg);
    font-size: {{ section.settings.tamano }}px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .pp-ticker__track {
    display: flex;
    width: max-content;
    animation: pp-ticker var(--tk-dur) linear infinite;
  }
  .pp-ticker__group {
    display: flex;
    flex-shrink: 0;
  }
  .pp-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 0;
  }
  .pp-ticker__item::after {
    content: "{{ section.settings.separador | escape }}";
    padding: 0 18px;
    opacity: 0.6;
  }
  @keyframes pp-ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pp-ticker__track { animation: none; }
  }
</style>

{%- if total > 0 -%}
  <div id="pp-ticker-{{ section.id }}" class="pp pp-ticker" role="region" aria-label="Beneficios">
    <div class="pp-ticker__track">
      {%- comment -%} Dos copias idénticas para que el loop no tenga saltos {%- endcomment -%}
      {%- for copia in (1..2) -%}
        <div class="pp-ticker__group"{% if copia == 2 %} aria-hidden="true"{% endif %}>
          {%- comment -%} Se repite el set para que llene pantallas anchas {%- endcomment -%}
          {%- for rep in (1..4) -%}
            {%- for block in section.blocks -%}
              <span class="pp-ticker__item" {% if forloop.first and rep == 1 and copia == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {{- block.settings.texto -}}
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PP · Barra animada",
  "tag": "section",
  "class": "pp-ticker-section",
  "settings": [
    { "type": "color", "id": "fondo", "label": "Fondo", "default": "#c5453f" },
    { "type": "color", "id": "texto", "label": "Texto", "default": "#ffffff" },
    { "type": "range", "id": "tamano", "label": "Tamaño del texto", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "velocidad", "label": "Duración de una vuelta (más = más lento)", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 30 },
    { "type": "text", "id": "separador", "label": "Separador entre mensajes", "default": "•" }
  ],
  "blocks": [
    {
      "type": "mensaje",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto (puedes usar emojis)", "default": "Envío GRATIS a toda Guatemala 🚚" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Barra animada",
      "blocks": [
        { "type": "mensaje", "settings": { "texto": "Envío GRATIS a toda Guatemala 🚚" } },
        { "type": "mensaje", "settings": { "texto": "Pagás al recibir 💵" } },
        { "type": "mensaje", "settings": { "texto": "+5.600 clientes felices ⭐⭐⭐⭐⭐" } }
      ]
    }
  ]
}
{% endschema %}
