{%- comment -%}
  PP · Preguntas frecuentes
  Acordeón de preguntas y respuestas (no necesita JavaScript).
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

<style>
  .pp-faq__lista { max-width: 760px; margin: 0 auto; display: grid; gap: 10px; }
  .pp-faq__item {
    border: 1px solid var(--pp-borde); border-radius: var(--pp-radio); background: var(--pp-fondo);
  }
  .pp-bg--oscuro .pp-faq__item { background: rgba(255, 255, 255, .06); border-color: rgba(255, 255, 255, .16); }
  .pp-faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 16px; cursor: pointer; list-style: none;
    font-size: 16px; font-weight: 700; line-height: 1.35;
  }
  .pp-faq__item summary::-webkit-details-marker { display: none; }
  .pp-faq__item summary::after {
    content: "+"; flex: 0 0 auto; font-size: 22px; font-weight: 400; line-height: 1;
    color: var(--pp-acento); transition: transform .2s ease;
  }
  .pp-faq__item[open] summary::after { transform: rotate(45deg); }
  .pp-faq__item summary:focus-visible { outline: 2px solid var(--pp-acento); outline-offset: 2px; border-radius: var(--pp-radio); }
  .pp-faq__resp { padding: 0 16px 16px; font-size: 15px; color: var(--pp-texto-2); }
  .pp-bg--oscuro .pp-faq__resp { color: inherit; opacity: .85; }
  .pp-faq__resp p + p { margin-top: 8px; }
  .pp-faq--lineas { gap: 0; }
  .pp-faq--lineas .pp-faq__item { border: 0; border-bottom: 1px solid var(--pp-borde); border-radius: 0; background: transparent !important; }
  .pp-faq--lineas .pp-faq__item summary { padding: 20px 2px; }
  .pp-faq--lineas .pp-faq__resp { padding: 0 2px 20px; }
  .pp-faq__wa {
    justify-self: center; display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; padding: 12px 22px;
    border-radius: 99px; background: #25d366; color: #fff; font-weight: 800; text-decoration: none;
  }
</style>

<div class="pp pp-section pp-bg--{{ section.settings.fondo }}">
  <div class="pp-wrap">
    <div class="pp-head">
      {%- if section.settings.etiqueta != blank -%}<p class="pp-eyebrow">{{ section.settings.etiqueta }}</p>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
      {%- if section.settings.whatsapp != blank -%}
        {%- assign wa = section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
        <a class="pp-faq__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ section.settings.whatsapp_texto }}</a>
      {%- endif -%}
    </div>
    <div class="pp-faq__lista pp-faq--{{ section.settings.estilo }}">
      {%- for block in section.blocks -%}
        <details class="pp-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.abrir_primera %} open{% endif %}>
          <summary>{{ block.settings.pregunta }}</summary>
          <div class="pp-faq__resp">{{ block.settings.respuesta }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PP · Preguntas",
  "tag": "section",
  "class": "pp-faq-section",
  "settings": [
    {
      "type": "select", "id": "fondo", "label": "Fondo", "default": "fondo-2",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" },
        { "value": "oscuro", "label": "Oscuro" }
      ]
    },
    {
      "type": "select", "id": "estilo", "label": "Estilo", "default": "tarjetas",
      "options": [
        { "value": "tarjetas", "label": "Tarjetas" },
        { "value": "lineas", "label": "Líneas" }
      ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña (opcional)" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular", "default": "Preguntas frecuentes" },
    { "type": "inline_richtext", "id": "texto", "label": "Texto (opcional)" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp con código de país (opcional, ej: 50252309787)" },
    { "type": "text", "id": "whatsapp_texto", "label": "Texto del botón de WhatsApp", "default": "Escríbenos por WhatsApp" },
    { "type": "checkbox", "id": "abrir_primera", "label": "Dejar la primera pregunta abierta", "default": true }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Cómo pago?" },
        { "type": "richtext", "id": "respuesta", "label": "Respuesta", "default": "<p>Contraentrega. Pagás directo al mensajero cuando recibís tu pedido — nada por adelantado.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Preguntas",
      "blocks": [
        { "type": "pregunta", "settings": { "pregunta": "¿Por qué el líquido sale oscuro cuando lo escupís?", "respuesta": "<p>Así es la fórmula desde que sale del frasco. Ese color le permite adherirse a los residuos de lengua, mejillas y encías que el cepillo no alcanza — no es \"toda la suciedad de tu boca de golpe\".</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Cuánto tarda en llegar mi pedido?", "respuesta": "<p>Entre 24 y 48 horas en la mayoría de zonas de Guatemala.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Cómo pago?", "respuesta": "<p>Contraentrega. Pagás directo al mensajero cuando recibís tu pedido — nada por adelantado.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Qué pasa si mi pedido llega dañado?", "respuesta": "<p>Te lo reponemos sin costo. Escribinos por WhatsApp con tu número de pedido.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Reemplaza el cepillado normal?", "respuesta": "<p>No, lo complementa. Funciona mejor como parte de tu rutina diaria de cepillado, no como reemplazo.</p>" } },
        { "type": "pregunta", "settings": { "pregunta": "¿Contiene alcohol?", "respuesta": "<p>No. Es una fórmula sin alcohol, apta para uso diario.</p>" } }
      ]
    }
  ]
}
{% endschema %}
