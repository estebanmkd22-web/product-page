{%- comment -%}
  PP · Secuencia
  Etiqueta + titular + texto + imagen principal y una fila de 2 a 4 fotos
  unidas con flechas (ej: "Residuos dispersos › Se agrupan › Los puedes ver").
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

<style>
  .pp-seq__pill {
    justify-self: start; padding: 5px 12px; border-radius: 99px; background: var(--pp-acento); color: #fff;
    font-size: 12px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
  }
  .pp-head:not(.pp-head--izq) .pp-seq__pill { justify-self: center; }
  #pp-seq-{{ section.id }} .pp-seq__img { aspect-ratio: {{ section.settings.proporcion }}; max-width: 760px; margin: 0 auto; }
  #pp-seq-{{ section.id }} .pp-head { max-width: 760px; margin-left: auto; margin-right: auto; }
  .pp-seq__fila { display: flex; align-items: flex-start; gap: 4px; max-width: 760px; margin: 18px auto 0; }
  .pp-seq__paso { flex: 1 1 0; min-width: 0; }
  .pp-seq__paso .pp-img { aspect-ratio: 4 / 3; }
  .pp-seq__paso p { margin-top: 8px; text-align: center; font-size: 11px; font-weight: 800; line-height: 1.2; text-transform: uppercase; }
  .pp-seq__flecha { flex: 0 0 auto; align-self: center; margin-top: -18px; color: var(--pp-acento); font-size: 22px; font-weight: 900; line-height: 1; }
  @media (min-width: 750px) {
    .pp-seq__fila { gap: 12px; margin-top: 24px; }
    .pp-seq__paso p { font-size: 14px; }
    .pp-seq__flecha { font-size: 30px; }
  }
</style>

<div id="pp-seq-{{ section.id }}" class="pp pp-section pp-bg--{{ section.settings.fondo }}">
  <div class="pp-wrap">
    <div class="pp-head{% if section.settings.alineacion == 'izq' %} pp-head--izq{% endif %}">
      {%- if section.settings.etiqueta != blank -%}<span class="pp-seq__pill">{{ section.settings.etiqueta }}</span>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    {%- if section.settings.imagen != blank -%}
      <div class="pp-img pp-seq__img">
        {{ section.settings.imagen | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 760px) 760px, 100vw' }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pp-seq__fila">
        {%- for block in section.blocks -%}
          <div class="pp-seq__paso" {{ block.shopify_attributes }}>
            <div class="pp-img">
              {%- if block.settings.imagen != blank -%}
                {{ block.settings.imagen | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 350, 500', sizes: '(min-width: 760px) 240px, 30vw', alt: block.settings.texto }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
          </div>
          {%- unless forloop.last -%}<span class="pp-seq__flecha" aria-hidden="true">›</span>{%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cierre != blank -%}
      <p class="pp-cierre{% if section.settings.cierre_franja %} pp-cierre--franja{% endif %}">{{ section.settings.cierre }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PP · Secuencia",
  "tag": "section",
  "class": "pp-secuencia-section",
  "settings": [
    {
      "type": "select", "id": "fondo", "label": "Fondo", "default": "fondo-2",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" },
        { "value": "oscuro", "label": "Oscuro" }
      ]
    },
    {
      "type": "select", "id": "alineacion", "label": "Alineación del texto", "default": "izq",
      "options": [ { "value": "izq", "label": "Izquierda" }, { "value": "centro", "label": "Centrado" } ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta (sale en una cápsula de color)", "default": "La parte que tienes que ver" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular (la cursiva sale en color de acento)", "default": "Enjuagas. Y lo que estaba ahí <em>empieza a aparecer.</em>" },
    { "type": "inline_richtext", "id": "texto", "label": "Texto", "default": "La fórmula ayuda a agrupar residuos y partículas presentes en tu boca durante el enjuague." },
    { "type": "image_picker", "id": "imagen", "label": "Imagen principal" },
    {
      "type": "select", "id": "proporcion", "label": "Formato de la imagen principal", "default": "5 / 4",
      "options": [
        { "value": "1 / 1", "label": "Cuadrado (1:1)" },
        { "value": "5 / 4", "label": "Casi cuadrado (5:4)" },
        { "value": "16 / 9", "label": "Horizontal (16:9)" }
      ]
    },
    { "type": "inline_richtext", "id": "cierre", "label": "Frase de cierre (opcional)", "default": "Ahí entiendes por qué un cepillo no siempre cuenta toda la historia." },
    { "type": "checkbox", "id": "cierre_franja", "label": "Frase de cierre en franja de color", "default": true }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Foto de la secuencia",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen" },
        { "type": "text", "id": "texto", "label": "Texto debajo", "default": "Residuos dispersos" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Secuencia",
      "blocks": [
        { "type": "paso", "settings": { "texto": "Residuos dispersos" } },
        { "type": "paso", "settings": { "texto": "Se agrupan" } },
        { "type": "paso", "settings": { "texto": "Los puedes ver" } }
      ]
    }
  ]
}
{% endschema %}
