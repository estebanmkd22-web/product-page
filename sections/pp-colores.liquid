{%- comment -%}
  PP · Colores y tarjetas
  Titular en 2 líneas (la 2ª en color de acento) + línea + subtítulo,
  fila de variantes de color (foto + nombre subrayado con su color)
  y tarjetas con foto, titular grande y texto (ej: "ESTILO." / "CALIDAD.").
  Fuente: Manrope (Google Fonts), con opción de titular condensado.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: usan la fuente de títulos del tema (Dawn) */
.pp-h {
  font-family: var(--font-heading-family, inherit);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>
{%- assign s = section.settings -%}
{%- assign variantes = section.blocks | where: 'type', 'variante' -%}
{%- assign tarjetas = section.blocks | where: 'type', 'tarjeta' -%}

{%- if s.cargar_fuente -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800{% if s.fuente_titulo == 'anton' %}&family=Anton{% endif %}&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #pp-colores-{{ section.id }} {
    /* ===== Colores y medidas (también se cambian desde el panel) ===== */
    --c-fondo: {{ s.fondo }};
    --c-texto: {{ s.color_texto }};
    --c-acento: {{ s.color_acento }};
    --c-acento-2: {{ s.color_acento_2 }};
    --c-tarjeta: {{ s.tarjeta_fondo }};
    --titulo-max: {{ s.tamano_titulo }}px;
    --radio: 18px;

    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-fondo);
    color: var(--c-texto);
    font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Fondo con luz suave y arcoíris tenue (sin imagen, no pesa nada) */
  #pp-colores-{{ section.id }}.pp-colores--luz {
    background:
      radial-gradient(90% 45% at 50% 0%, rgba(255, 255, 255, 0.95), transparent 70%),
      radial-gradient(60% 35% at 0% 38%, rgba(255, 255, 255, 0.85), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--c-fondo) 40%, #fff), var(--c-fondo) 55%, color-mix(in srgb, var(--c-fondo) 60%, #fff));
  }
  #pp-colores-{{ section.id }}.pp-colores--luz::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(circle at 105% 42%,
      transparent 44%,
      rgba(255, 90, 90, 0.07) 45.5%,
      rgba(255, 210, 80, 0.07) 47%,
      rgba(80, 210, 140, 0.07) 48.5%,
      rgba(90, 150, 255, 0.07) 50%,
      transparent 52%);
  }
  #pp-colores-{{ section.id }} .pp-colores__bgimg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  #pp-colores-{{ section.id }} .pp-colores__bgimg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #pp-colores-{{ section.id }} .pp-wrap { max-width: 1040px; }

  /* ===== Encabezado ===== */
  #pp-colores-{{ section.id }} .pp-colores__head { text-align: center; }
  #pp-colores-{{ section.id }} .pp-colores__titulo {
    font-family: inherit;
    font-size: clamp(22px, 6.3vw, var(--titulo-max));
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--c-texto);
  }
  #pp-colores-{{ section.id }} .pp-colores__titulo span { display: block; }
  #pp-colores-{{ section.id }} .pp-colores__titulo span + span { color: var(--c-acento); }
  #pp-colores-{{ section.id }} .pp-colores__linea {
    width: min(440px, 72%);
    height: 2px;
    margin: 18px auto 14px;
    background: linear-gradient(90deg, transparent, var(--c-texto) 50%, transparent);
    opacity: 0.85;
  }
  #pp-colores-{{ section.id }} .pp-colores__sub {
    font-size: clamp(13px, 3.7vw, 20px);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  #pp-colores-{{ section.id }} .pp-colores__sub :is(em, i) {
    font-style: normal;
    color: var(--c-acento-2);
  }

  /* ===== Variantes de color ===== */
  #pp-colores-{{ section.id }} .pp-colores__variantes {
    display: grid;
    grid-template-columns: repeat({{ variantes.size | at_least: 1 | at_most: 4 }}, 1fr);
    gap: 12px;
    margin-top: 22px;
  }
  #pp-colores-{{ section.id }} .pp-colores__var {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  #pp-colores-{{ section.id }} .pp-colores__var img,
  #pp-colores-{{ section.id }} .pp-colores__var svg {
    width: 100%;
    max-width: 340px;
    aspect-ratio: 38 / 30;
    object-fit: contain;
  }
  #pp-colores-{{ section.id }}.pp-colores--fusion .pp-colores__var img { mix-blend-mode: multiply; }
  #pp-colores-{{ section.id }} .pp-colores__nombre {
    margin-top: 10px;
    padding: 0 0 6px 0.4em;
    border-bottom: 3px solid var(--linea, var(--c-texto));
    font-size: clamp(12px, 3.4vw, 16px);
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  /* ===== Tarjetas ===== */
  #pp-colores-{{ section.id }} .pp-colores__tarjetas {
    display: grid;
    grid-template-columns: repeat({% if s.tarjetas_movil == '1' %}1{% else %}2{% endif %}, 1fr);
    gap: 12px;
    margin-top: 30px;
  }
  #pp-colores-{{ section.id }} .pp-colores__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--c-tarjeta);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
  }
  #pp-colores-{{ section.id }} .pp-colores__foto {
    position: relative;
    aspect-ratio: 5 / 4;
  }
  #pp-colores-{{ section.id }} .pp-colores__foto img,
  #pp-colores-{{ section.id }} .pp-colores__foto svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Difuminado de la foto hacia el fondo de la tarjeta, donde va el texto */
  #pp-colores-{{ section.id }} .pp-colores__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, var(--c-tarjeta));
  }
  #pp-colores-{{ section.id }} .pp-colores__cuerpo {
    position: relative;
    margin-top: -14px;
    padding: 0 12px 18px;
  }
  #pp-colores-{{ section.id }} .pp-colores__card-titulo {
    font-family: inherit;
    font-size: clamp(22px, 6.6vw, 58px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--c-texto);
  }
  #pp-colores-{{ section.id }} .pp-colores__card-texto {
    margin-top: 8px;
    font-size: clamp(10.5px, 2.9vw, 17px);
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
  }
  #pp-colores-{{ section.id }} .pp-colores__card-texto :is(strong, b) { font-weight: 800; }

  /* Titulares condensados (más parecidos a la imagen de referencia) */
  #pp-colores-{{ section.id }}.pp-colores--anton :is(.pp-colores__titulo, .pp-colores__card-titulo) {
    font-family: 'Anton', 'Manrope', sans-serif;
    font-weight: 400;
    letter-spacing: 0;
  }
  #pp-colores-{{ section.id }}.pp-colores--anton .pp-colores__titulo { font-size: clamp(30px, 10vw, var(--titulo-max)); line-height: 1.05; }
  #pp-colores-{{ section.id }}.pp-colores--anton .pp-colores__card-titulo { font-size: clamp(28px, 8.6vw, 64px); }

  @media (min-width: 750px) {
    #pp-colores-{{ section.id }} .pp-colores__variantes { gap: 40px; margin-top: 36px; }
    #pp-colores-{{ section.id }} .pp-colores__tarjetas { grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 44px; }
    #pp-colores-{{ section.id }} .pp-colores__cuerpo { margin-top: -24px; padding: 0 24px 28px; }
    #pp-colores-{{ section.id }}:not(.pp-colores--anton) .pp-colores__card-titulo { font-size: clamp(36px, 5vw, 58px); }
    #pp-colores-{{ section.id }} .pp-colores__card-texto { font-size: clamp(13px, 1.6vw, 17px); }
  }
</style>

<div
  id="pp-colores-{{ section.id }}"
  class="pp pp-section pp-colores{% if s.efecto_luz and s.imagen_fondo == blank %} pp-colores--luz{% endif %}{% if s.fusionar_fondo %} pp-colores--fusion{% endif %}{% if s.fuente_titulo == 'anton' %} pp-colores--anton{% endif %}"
>
  {%- if s.imagen_fondo != blank -%}
    <div class="pp-colores__bgimg">
      {{ s.imagen_fondo | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '750, 1100, 1600', sizes: '100vw', alt: '' }}
    </div>
  {%- endif -%}

  <div class="pp-wrap">
    <div class="pp-colores__head">
      {%- if s.titulo_1 != blank or s.titulo_2 != blank -%}
        <h2 class="pp-colores__titulo">
          {%- if s.titulo_1 != blank -%}<span>{{ s.titulo_1 }}</span>{%- endif -%}
          {%- if s.titulo_2 != blank -%}<span>{{ s.titulo_2 }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if s.mostrar_linea -%}<div class="pp-colores__linea" aria-hidden="true"></div>{%- endif -%}
      {%- if s.subtitulo != blank -%}<p class="pp-colores__sub">{{ s.subtitulo }}</p>{%- endif -%}
    </div>

    {%- if variantes.size > 0 -%}
      <div class="pp-colores__variantes">
        {%- for block in variantes -%}
          {%- assign b = block.settings -%}
          {%- if b.enlace != blank -%}<a href="{{ b.enlace }}"{% else %}<div{% endif %} class="pp-colores__var" style="--linea: {{ b.color_linea }}" {{ block.shopify_attributes }}>
            {%- if b.imagen != blank -%}
              {{ b.imagen | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 750px) 340px, 45vw', alt: b.nombre }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if b.nombre != blank -%}<span class="pp-colores__nombre">{{ b.nombre }}</span>{%- endif -%}
          {%- if b.enlace != blank -%}</a>{% else %}</div>{% endif %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if tarjetas.size > 0 -%}
      <div class="pp-colores__tarjetas">
        {%- for block in tarjetas -%}
          {%- assign b = block.settings -%}
          <div class="pp-colores__card" {{ block.shopify_attributes }}>
            <div class="pp-colores__foto">
              {%- if b.imagen != blank -%}
                {{ b.imagen | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 500px, 50vw', alt: b.titulo }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="pp-colores__cuerpo">
              {%- if b.titulo != blank -%}<h3 class="pp-colores__card-titulo">{{ b.titulo }}</h3>{%- endif -%}
              {%- if b.texto != blank -%}<p class="pp-colores__card-texto">{{ b.texto }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PP · Colores y tarjetas",
  "tag": "section",
  "class": "pp-colores-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Fuente" },
    {
      "type": "select", "id": "fuente_titulo", "label": "Estilo de los titulares", "default": "manrope",
      "options": [
        { "value": "manrope", "label": "Manrope (gruesa)" },
        { "value": "anton", "label": "Condensada (Anton, como la imagen original)" }
      ]
    },
    { "type": "checkbox", "id": "cargar_fuente", "label": "Cargar Manrope desde Google Fonts", "default": true, "info": "Desactívalo si tu tema ya usa Manrope." },
    { "type": "range", "id": "tamano_titulo", "label": "Tamaño máximo del titular", "min": 40, "max": 96, "step": 2, "unit": "px", "default": 72 },

    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "fondo", "label": "Fondo", "default": "#ececec" },
    { "type": "checkbox", "id": "efecto_luz", "label": "Efecto de luz y arcoíris suave en el fondo", "default": true },
    { "type": "image_picker", "id": "imagen_fondo", "label": "Imagen de fondo (opcional)", "info": "Reemplaza el color y el efecto de luz." },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#151515" },
    { "type": "color", "id": "color_acento", "label": "Acento (2ª línea del titular)", "default": "#a0521d" },
    { "type": "color", "id": "color_acento_2", "label": "Acento del subtítulo (cursiva)", "default": "#c8732a" },
    { "type": "color", "id": "tarjeta_fondo", "label": "Fondo de las tarjetas", "default": "#ffffff" },

    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "titulo_1", "label": "Titular · línea 1", "default": "Diseño que se ve." },
    { "type": "text", "id": "titulo_2", "label": "Titular · línea 2 (en color de acento)", "default": "Sonido que se siente." },
    { "type": "checkbox", "id": "mostrar_linea", "label": "Mostrar línea debajo del titular", "default": true },
    { "type": "inline_richtext", "id": "subtitulo", "label": "Subtítulo (la cursiva sale en color de acento)", "default": "Dos colores que se adaptan <em>a tu gusto.</em>" },

    { "type": "header", "content": "Variantes y tarjetas" },
    { "type": "checkbox", "id": "fusionar_fondo", "label": "Fundir el fondo claro de las fotos de variantes", "default": true, "info": "Útil si las fotos tienen fondo blanco o gris. Con PNG sin fondo no hace falta." },
    {
      "type": "select", "id": "tarjetas_movil", "label": "Tarjetas en celular", "default": "2",
      "options": [
        { "value": "2", "label": "2 por fila (como la imagen)" },
        { "value": "1", "label": "1 por fila (más grandes)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "variante",
      "name": "Variante de color",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto del producto", "info": "Ideal: PNG/WebP sin fondo, misma proporción en todas." },
        { "type": "text", "id": "nombre", "label": "Nombre del color", "default": "Verde" },
        { "type": "color", "id": "color_linea", "label": "Color de la línea", "default": "#5f6b38" },
        { "type": "url", "id": "enlace", "label": "Enlace (opcional)" }
      ]
    },
    {
      "type": "tarjeta",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto (sin texto)", "info": "Horizontal 5:4. La parte de abajo se difumina." },
        { "type": "text", "id": "titulo", "label": "Titular", "default": "Estilo." },
        { "type": "inline_richtext", "id": "texto", "label": "Texto (la negrita sale más gruesa)", "default": "<strong>Un diseño único que te acompaña</strong> todos los días." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Colores y tarjetas",
      "blocks": [
