{%- comment -%}
  PP · Cómo funciona
  Imagen del producto + lista de puntos (imagen pequeña, título y texto).
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   :where() deja estos colores con prioridad mínima, así
   "PP · Estilos globales" siempre los reemplaza. */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

.pp {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.pp img {
  display: block;
  max-width: 100%;
  height: auto;
}

.pp h1,
.pp h2,
.pp h3,
.pp p,
.pp ul {
  margin: 0;
}

.pp ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: usan la fuente de títulos del tema (Dawn) */
.pp-h {
  font-family: var(--font-heading-family, inherit);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}
/* PP-BASE:END */
</style>

<style>
  .pp-como__grid { display: grid; gap: 28px; align-items: center; }
  .pp-como__lista { display: grid; gap: 14px; }
  .pp-como__item {
    display: grid; grid-template-columns: 76px 1fr; gap: 14px; align-items: center;
    padding: 12px; border-radius: var(--pp-radio); background: var(--pp-fondo);
  }
  .pp-bg--fondo .pp-como__item { background: var(--pp-fondo-2); }
  .pp-bg--oscuro .pp-como__item { background: rgba(255, 255, 255, .08); }
  .pp-como__item .pp-img { aspect-ratio: 1 / 1; }
  .pp-como__item h3 { font-size: 16px; font-weight: 800; line-height: 1.25; }
  .pp-como__item p { margin-top: 2px; font-size: 14px; color: var(--pp-texto-2); }
  .pp-bg--oscuro .pp-como__item p { color: inherit; opacity: .8; }
  #pp-como-{{ section.id }} .pp-como__media { aspect-ratio: {{ section.settings.proporcion }}; }
  @media (min-width: 750px) {
    .pp-como__grid--con-img { grid-template-columns: 1fr 1.1fr; gap: 48px; }
    .pp-como__item { grid-template-columns: 92px 1fr; padding: 14px; }
  }
</style>

<div id="pp-como-{{ section.id }}" class="pp pp-section pp-bg--{{ section.settings.fondo }}">
  <div class="pp-wrap">
    <div class="pp-head">
      {%- if section.settings.etiqueta != blank -%}<p class="pp-eyebrow">{{ section.settings.etiqueta }}</p>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    <div class="pp-como__grid{% if section.settings.imagen != blank %} pp-como__grid--con-img{% endif %}">
      {%- if section.settings.imagen != blank -%}
        <div class="pp-img pp-como__media">
          {{ section.settings.imagen | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 520px, 100vw' }}
        </div>
      {%- endif -%}

      <div class="pp-como__lista">
        {%- for block in section.blocks -%}
          <div class="pp-como__item" {{ block.shopify_attributes }}>
            <div class="pp-img">
              {%- if block.settings.imagen != blank -%}
                {{ block.settings.imagen | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '92px' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div>
              <h3>{{ block.settings.titulo }}</h3>
              {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PP · Cómo funciona",
  "tag": "section",
  "class": "pp-como-section",
  "settings": [
    {
      "type": "select", "id": "fondo", "label": "Fondo", "default": "fondo-2",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" },
        { "value": "oscuro", "label": "Oscuro" }
      ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "Cómo funciona" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular (la cursiva sale en color de acento)", "default": "iD Whitening llega <em>a cada rincón</em>" },
    { "type": "inline_richtext", "id": "texto", "label": "Texto (opcional)" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen principal (opcional)" },
    {
      "type": "select", "id": "proporcion", "label": "Formato de la imagen principal", "default": "4 / 5",
      "options": [
        { "value": "1 / 1", "label": "Cuadrado (1:1)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Punto",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen pequeña (cuadrada)" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Llega a cada rincón" },
        { "type": "textarea", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Cómo funciona",
      "blocks": [
        { "type": "punto", "settings": { "titulo": "Llega a cada rincón", "texto": "A diferencia de un cepillo, que solo toca las superficies, la fórmula líquida recubre toda la boca — cada hueco, surco y grieta — en segundos." } },
        { "type": "punto", "settings": { "titulo": "Peróxido de hidrógeno + aceites esenciales", "texto": "Elimina la suciedad oculta y ayuda a mantener los dientes más blancos, mientras refresca el aliento desde el primer uso." } },
        { "type": "punto", "settings": { "titulo": "Lengua, mejillas y encías", "texto": "Actúa en las zonas donde se acumulan residuos y bacterias — la causa más común del mal aliento persistente." } },
        { "type": "punto", "settings": { "titulo": "Resultado inmediato", "texto": "No hay que esperar semanas. La sensación de limpieza y frescura se nota desde el primer buche." } }
      ]
    }
  ]
}
{% endschema %}
