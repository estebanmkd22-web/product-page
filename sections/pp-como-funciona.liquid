{%- comment -%}
  PP · Cómo funciona
  Slider de tarjetas (imagen, título y texto) que se desliza de lado.
  También puede mostrarse como lista. Imagen principal opcional arriba.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   :where() deja estos colores con prioridad mínima, así
   "PP · Estilos globales" siempre los reemplaza. */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

.pp {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.pp img {
  display: block;
  max-width: 100%;
  height: auto;
}

.pp h1,
.pp h2,
.pp h3,
.pp p,
.pp ul {
  margin: 0;
}

.pp ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: usan la fuente de títulos del tema (Dawn) */
.pp-h {
  font-family: var(--font-heading-family, inherit);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}
/* PP-BASE:END */
</style>

<style>
  #pp-como-{{ section.id }} { --como-card: {{ section.settings.fondo_tarjeta }}; --como-w: {{ section.settings.ancho_tarjeta }}%; }
  #pp-como-{{ section.id }} .pp-como__media { aspect-ratio: {{ section.settings.proporcion }}; margin-bottom: 20px; }
  #pp-como-{{ section.id }} .pp-como__foto { aspect-ratio: {{ section.settings.proporcion_punto }}; }
  .pp-como__card h3 { font-size: 20px; font-weight: 800; line-height: 1.2; }
  .pp-como__card p { font-size: 15px; color: var(--pp-texto-2); }
  .pp-bg--oscuro .pp-como__card p { color: inherit; opacity: .8; }

  /* ---- Diseño slider ---- */
  .pp-como--slider .pp-como__track {
    display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory;
    margin: 0 -16px; padding: 0 16px; scroll-padding: 0 16px;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .pp-como--slider .pp-como__track::-webkit-scrollbar { display: none; }
  .pp-como--slider .pp-como__card {
    flex: 0 0 var(--como-w); scroll-snap-align: start; overflow: hidden;
    border-radius: var(--pp-radio); background: var(--como-card);
  }
  .pp-como--slider .pp-como__foto { border-radius: 0; }
  .pp-como--slider .pp-como__txt { display: grid; gap: 6px; padding: 16px; }
  .pp-como__nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 14px; }
  .pp-como__dots { display: flex; gap: 6px; }
  .pp-como__dots button {
    width: 7px; height: 7px; padding: 0; border: 0; border-radius: 99px;
    background: var(--pp-borde); cursor: pointer; transition: width .2s, background .2s;
  }
  .pp-como__dots button[aria-current="true"] { width: 20px; background: var(--pp-acento); }
  .pp-como__flecha {
    display: grid; place-items: center; width: 36px; height: 36px; padding: 0;
    border: 1px solid var(--pp-borde); border-radius: 99px; background: var(--pp-fondo);
    color: var(--pp-texto); font-size: 18px; line-height: 1; cursor: pointer;
  }
  .pp-como__flecha:disabled { opacity: .35; cursor: default; }

  /* ---- Diseño lista ---- */
  .pp-como--lista .pp-como__track { display: grid; gap: 14px; }
  .pp-como--lista .pp-como__card {
    display: grid; grid-template-columns: 92px 1fr; gap: 14px; align-items: center;
    padding: 12px; border-radius: var(--pp-radio); background: var(--como-card);
  }
  .pp-como--lista .pp-como__foto { aspect-ratio: 1 / 1; }
  .pp-como--lista .pp-como__card h3 { font-size: 16px; }
  .pp-como--lista .pp-como__card p { font-size: 14px; }

  @media (min-width: 750px) {
    .pp-como--slider .pp-como__card { flex-basis: calc((100% - 36px) / {{ section.settings.tarjetas_pc }}); }
    .pp-como--slider .pp-como__track { margin: 0; padding: 0; }
    .pp-como--lista .pp-como__track { grid-template-columns: 1fr 1fr; }
  }
</style>

<div id="pp-como-{{ section.id }}" class="pp pp-section pp-bg--{{ section.settings.fondo }} pp-como--{{ section.settings.disenio }}">
  <div class="pp-wrap">
    <div class="pp-head">
      {%- if section.settings.etiqueta != blank -%}<p class="pp-eyebrow">{{ section.settings.etiqueta }}</p>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    {%- if section.settings.imagen != blank -%}
      <div class="pp-img pp-como__media">
        {{ section.settings.imagen | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 720px, 100vw' }}
      </div>
    {%- endif -%}

    <div class="pp-como__track" data-pp-como-track>
      {%- for block in section.blocks -%}
        <div class="pp-como__card" {{ block.shopify_attributes }}>
          <div class="pp-img pp-como__foto">
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 900 | image_tag: loading: 'lazy', widths: '200, 400, 600, 900', sizes: '(min-width: 750px) 360px, 86vw', alt: block.settings.titulo }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="pp-como__txt">
            <h3>{{ block.settings.titulo }}</h3>
            {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.disenio == 'slider' and section.blocks.size > 1 -%}
      <div class="pp-como__nav">
        {%- if section.settings.flechas -%}<button type="button" class="pp-como__flecha" data-pp-como-prev aria-label="Anterior">‹</button>{%- endif -%}
        <div class="pp-como__dots" data-pp-como-dots></div>
        {%- if section.settings.flechas -%}<button type="button" class="pp-como__flecha" data-pp-como-next aria-label="Siguiente">›</button>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.disenio == 'slider' -%}
<script>
  (function () {
    var root = document.getElementById('pp-como-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-pp-como-track]');
    var dotsBox = root.querySelector('[data-pp-como-dots]');
    var prev = root.querySelector('[data-pp-como-prev]');
    var next = root.querySelector('[data-pp-como-next]');
    var cards = track ? track.children : [];
    if (!dotsBox || cards.length < 2) return;
    var dots = [];
    var actual = 0;
    function ir(n) {
      n = Math.max(0, Math.min(cards.length - 1, n));
      track.scrollTo({ left: cards[n].offsetLeft - cards[0].offsetLeft, behavior: 'smooth' });
    }
    for (var i = 0; i < cards.length; i++) {
      var b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', 'Tarjeta ' + (i + 1));
      b.addEventListener('click', (function (n) { return function () { ir(n); }; })(i));
      dotsBox.appendChild(b);
      dots.push(b);
    }
    function marcar() {
      var paso = cards[1].offsetLeft - cards[0].offsetLeft;
      actual = Math.round(track.scrollLeft / paso);
      var fin = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      if (fin) actual = cards.length - 1;
      dots.forEach(function (d, j) { d.setAttribute('aria-current', j === actual ? 'true' : 'false'); });
      if (prev) prev.disabled = actual === 0;
      if (next) next.disabled = fin;
    }
    if (prev) prev.addEventListener('click', function () { ir(actual - 1); });
    if (next) next.addEventListener('click', function () { ir(actual + 1); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(marcar); }, { passive: true });
    marcar();

    {%- if section.settings.autoplay %}
    /* Avance automático: se detiene en cuanto el cliente toca el slider */
    var reducir = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducir) {
      var timer = setInterval(function () { ir(actual >= cards.length - 1 ? 0 : actual + 1); }, {{ section.settings.segundos | times: 1000 }});
      ['pointerdown', 'touchstart', 'wheel'].forEach(function (ev) {
        track.addEventListener(ev, function () { clearInterval(timer); }, { passive: true, once: true });
      });
    }
    {%- endif %}
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "PP · Cómo funciona",
  "tag": "section",
  "class": "pp-como-section",
  "settings": [
    {
      "type": "select", "id": "fondo", "label": "Fondo de la sección", "default": "fondo",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" },
        { "value": "oscuro", "label": "Oscuro" }
      ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "Cómo funciona" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular (la cursiva sale en color de acento)", "default": "iD Whitening llega <em>a cada rincón</em>" },
    { "type": "inline_richtext", "id": "texto", "label": "Texto (opcional)" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen principal arriba (opcional)" },
    {
      "type": "select", "id": "proporcion", "label": "Formato de la imagen principal", "default": "4 / 5",
      "options": [
        { "value": "1 / 1", "label": "Cuadrado (1:1)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "16 / 9", "label": "Horizontal (16:9)" }
      ]
    },
    { "type": "header", "content": "Tarjetas" },
    {
      "type": "select", "id": "disenio", "label": "Diseño", "default": "slider",
      "options": [
        { "value": "slider", "label": "Slider (se desliza de lado)" },
        { "value": "lista", "label": "Lista (una debajo de otra)" }
      ]
    },
    { "type": "color", "id": "fondo_tarjeta", "label": "Fondo de las tarjetas", "default": "#fff2f5" },
    {
      "type": "select", "id": "proporcion_punto", "label": "Formato de la imagen de cada tarjeta", "default": "2 / 1",
      "options": [
        { "value": "2 / 1", "label": "Panorámica (2:1)" },
        { "value": "1 / 1", "label": "Cuadrado (1:1)" },
        { "value": "4 / 3", "label": "Horizontal (4:3)" },
        { "value": "16 / 9", "label": "Horizontal ancho (16:9)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" }
      ]
    },
    { "type": "header", "content": "Slider" },
    {
      "type": "range", "id": "ancho_tarjeta", "label": "Ancho de cada tarjeta en celular",
      "min": 70, "max": 100, "step": 2, "unit": "%", "default": 86,
      "info": "Menos de 100% deja ver un pedazo de la siguiente tarjeta, así se nota que se desliza."
    },
    {
      "type": "select", "id": "tarjetas_pc", "label": "Tarjetas visibles en computador", "default": "3",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ]
    },
    { "type": "checkbox", "id": "flechas", "label": "Mostrar flechas", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Avanzar solo", "default": false },
    { "type": "range", "id": "segundos", "label": "Segundos por tarjeta", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Llega a cada rincón" },
        { "type": "textarea", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Cómo funciona",
      "blocks": [
        { "type": "punto", "settings": { "titulo": "Llega a cada rincón", "texto": "A diferencia de un cepillo, que solo toca las superficies, la fórmula líquida recubre toda la boca — cada hueco, surco y grieta — en segundos." } },
        { "type": "punto", "settings": { "titulo": "Peróxido de hidrógeno + aceites esenciales", "texto": "Elimina la suciedad oculta y ayuda a mantener los dientes más blancos, mientras refresca el aliento desde el primer uso." } },
        { "type": "punto", "settings": { "titulo": "Lengua, mejillas y encías", "texto": "Actúa en las zonas donde se acumulan residuos y bacterias — la causa más común del mal aliento persistente." } },
        { "type": "punto", "settings": { "titulo": "Resultado inmediato", "texto": "No hay que esperar semanas. La sensación de limpieza y frescura se nota desde el primer buche." } }
      ]
    }
  ]
}
{% endschema %}
