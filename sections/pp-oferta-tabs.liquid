<script>
  (function () {
    var root = document.getElementById('pp-ot-{{ section.id }}');
    if (!root) return;
    var radios = root.querySelectorAll('.pp-ot__tab input');
    var cards = root.querySelectorAll('[data-pp-ot-card]');
    var gifts = root.querySelectorAll('.pp-ot__gift');
    var contador = root.querySelector('[data-pp-ot-contador]');
    var precio = root.querySelector('[data-pp-ot-precio]');
    var cantidad = root.querySelector('[data-pp-ot-cantidad]');
    var enlace = root.querySelector('[data-pp-ot-enlace]');
    var cajaRegalos = root.querySelector('[data-pp-ot-regalos]');
    var primera = true;
    function aplicar() {
      radios.forEach(function (r, i) {
        r.parentNode.classList.toggle('is-activo', r.checked);
        if (cards[i]) cards[i].classList.toggle('is-activo', r.checked);
        if (!r.checked) return;
        var cant = parseInt(r.dataset.cantidad || '1', 10);
        var visibles = 0;
        gifts.forEach(function (g) {
          var ver = cant >= parseInt(g.dataset.min || '1', 10);
          if (ver && g.hidden && !primera) { g.classList.remove('is-nuevo'); void g.offsetWidth; g.classList.add('is-nuevo'); }
          g.hidden = !ver;
          if (ver) visibles++;
        });
        if (contador) contador.textContent = visibles + ' / ' + visibles;
        if (cajaRegalos) cajaRegalos.setAttribute('data-n', visibles > 4 ? 3 : visibles);
        if (precio) precio.textContent = r.dataset.precio;
        if (cantidad) cantidad.value = cant;
        if (enlace) enlace.href = r.dataset.url || '#';
      });
      primera = false;
    }
    radios.forEach(function (r) { r.addEventListener('change', aplicar); });
    aplicar();
  })();
</script>

