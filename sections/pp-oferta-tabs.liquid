{%- comment -%}
  PP · Oferta con pestañas
  Pestañas (1 frasco / 2 frascos), tarjeta del pack elegido, caja "Incluido en tu pedido"
  con contador y beneficios (algunos se desbloquean desde cierta cantidad),
  valor de los beneficios, botón con precio y fila de confianza.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

{%- assign packs = section.blocks | where: 'type', 'pack' -%}
{%- assign regalos = section.blocks | where: 'type', 'regalo' -%}
{%- assign elegido = 0 -%}
{%- for block in packs -%}{%- if block.settings.preseleccionado -%}{%- assign elegido = forloop.index0 -%}{%- endif -%}{%- endfor -%}

<style>
  #pp-ot-{{ section.id }} {
    --ot-ac: {{ section.settings.color_acento }}; --ot-tab: {{ section.settings.color_pestana }};
    --ot-suave: color-mix(in srgb, var(--ot-ac) 10%, var(--pp-fondo));
  }
  .pp-ot { padding: {{ section.settings.espacio }}px 0; }
  .pp-ot__wrap { max-width: 560px; margin: 0 auto; }
  .pp-ot__tabs { display: grid; grid-template-columns: repeat({{ packs.size | at_least: 1 }}, 1fr); gap: 4px; padding: 4px; border-radius: 14px; background: color-mix(in srgb, var(--pp-texto) 7%, var(--pp-fondo)); }
  .pp-ot__tab { position: relative; display: grid; place-items: center; min-height: 46px; padding: 8px; border-radius: 11px; cursor: pointer; font-size: 16px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--pp-texto); transition: background .2s, color .2s; }
  .pp-ot__tab input { position: absolute; opacity: 0; pointer-events: none; }
  .pp-ot__tab.is-activo { background: var(--ot-tab); color: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.15); }
  .pp-ot__tab small { position: absolute; top: -9px; right: 8px; padding: 2px 8px; border-radius: 99px; background: var(--ot-ac); color: #fff; font-size: 10px; letter-spacing: .04em; }
  .pp-ot__card { display: none; margin-top: 14px; padding: 18px 16px; border: 1.5px solid var(--ot-ac); border-radius: 18px; background: var(--pp-fondo); }
  .pp-ot__card.is-activo { display: block; }
  .pp-ot__badge { display: inline-block; margin-bottom: 12px; padding: 5px 12px; border-radius: 99px; background: var(--ot-suave); color: var(--ot-ac); font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .pp-ot__fila { display: grid; grid-template-columns: 84px 1fr auto; gap: 12px; align-items: center; }
  .pp-ot__img { width: 84px; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: var(--pp-fondo-2); }
  .pp-ot__img img, .pp-ot__img svg { width: 100%; height: 100%; object-fit: contain; }
  .pp-ot__nombre { font-size: 15px; font-weight: 700; line-height: 1.3; }
  .pp-ot__regalo, .pp-ot__detalle { margin-top: 4px; font-size: 13px; color: var(--pp-texto-2); }
  .pp-ot__precios { text-align: right; }
  .pp-ot__precio { display: block; font-size: 26px; font-weight: 900; line-height: 1; }
  .pp-ot__antes { display: block; margin-top: 4px; font-size: 14px; color: var(--pp-texto-2); text-decoration: line-through; }
  .pp-ot__ahorro { display: inline-block; margin-top: 6px; padding: 2px 8px; border-radius: 6px; background: var(--ot-suave); color: var(--ot-ac); font-size: 11px; font-weight: 800; }
  .pp-ot__incluye { margin-top: 14px; padding: 16px 10px 12px; border: 1.5px dashed color-mix(in srgb, var(--ot-ac) 55%, transparent); border-radius: 18px; }
  .pp-ot__inc-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; font-size: 15px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; }
  .pp-ot__contador { color: var(--ot-ac); font-size: 13px; }
  .pp-ot__regalos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .pp-ot__regalos[data-n="1"] { grid-template-columns: 1fr; }
  .pp-ot__regalos[data-n="2"], .pp-ot__regalos[data-n="4"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 480px) { .pp-ot__regalos[data-n="4"] { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pp-ot__gift { position: relative; display: grid; justify-items: center; align-content: start; gap: 6px; padding: 10px 6px 12px; border: 1px solid color-mix(in srgb, var(--ot-ac) 35%, transparent); border-radius: 14px; background: var(--ot-suave); text-align: center; }
  .pp-ot__gift[hidden] { display: none; }
  .pp-ot__gift.is-nuevo { animation: pp-ot-pop .45s ease; }
  @keyframes pp-ot-pop { 0% { transform: scale(.85); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  .pp-ot__ginsignia { font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--ot-ac); }
  .pp-ot__gico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 99px; background: var(--pp-fondo); color: var(--ot-ac); font-size: 20px; box-shadow: 0 2px 6px rgba(0,0,0,.06); }
  .pp-ot__gtitulo { max-width: 100%; font-size: 12px; font-weight: 800; line-height: 1.2; text-transform: uppercase; overflow-wrap: anywhere; hyphens: auto; }
  .pp-ot__regalos[data-n="3"] .pp-ot__gtitulo { font-size: 10px; letter-spacing: -.02em; overflow-wrap: normal; hyphens: none; }
  .pp-ot__regalos[data-n="3"] .pp-ot__gift { padding-left: 3px; padding-right: 3px; }
  .pp-ot__gtexto { font-size: 11px; line-height: 1.25; color: var(--pp-texto-2); }
  .pp-ot__valor { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--pp-borde); font-size: 14px; font-weight: 700; color: var(--pp-texto-2); }
  .pp-ot__valor b { color: var(--ot-ac); font-weight: 900; letter-spacing: .04em; }
  .pp-ot__valor s { margin-right: 6px; font-weight: 600; }
  .pp-ot__cta { margin-top: 16px; }
  .pp-ot__nota { margin-top: 8px; text-align: center; font-size: 13px; color: var(--pp-texto-2); }
  .pp-ot__confianza { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; margin-top: 10px; font-size: 12px; font-weight: 600; color: var(--pp-texto-2); }
  .pp-ot__confianza span { display: inline-flex; align-items: center; gap: 5px; }
  .pp-ot__confianza .pp-ico { font-size: 16px; color: var(--ot-ac); }
  @media (max-width: 380px) { .pp-ot__fila { grid-template-columns: 64px 1fr auto; } .pp-ot__img { width: 64px; } .pp-ot__precio { font-size: 22px; } }
</style>

<div id="pp-ot-{{ section.id }}" class="pp pp-ot pp-bg--{{ section.settings.fondo }}" data-pp-oferta>
  <div class="pp-wrap"><div class="pp-ot__wrap">
    {%- if section.settings.titulo != blank -%}<div class="pp-head"><h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2></div>{%- endif -%}

    <div class="pp-ot__tabs" role="radiogroup" aria-label="Elige tu pack">
      {%- for block in packs -%}
        {%- assign precio = block.settings.precio | times: 100 -%}
        <label class="pp-ot__tab{% if forloop.index0 == elegido %} is-activo{% endif %}" {{ block.shopify_attributes }}>
          <input type="radio" name="pp-ot-{{ section.id }}" value="{{ forloop.index0 }}"
            data-precio="{{ precio | money_without_trailing_zeros | escape }}" data-cantidad="{{ block.settings.cantidad | default: 1 }}" data-url="{{ block.settings.enlace }}"
            {% if forloop.index0 == elegido %}checked{% endif %}>
          {{ block.settings.pestana }}
          {%- if block.settings.destacar != blank -%}<small>{{ block.settings.destacar }}</small>{%- endif -%}
        </label>
      {%- endfor -%}
    </div>

    {%- for block in packs -%}
      {%- assign precio = block.settings.precio | times: 100 -%}
      {%- assign antes = block.settings.precio_antes | times: 100 -%}
      <div class="pp-ot__card{% if forloop.index0 == elegido %} is-activo{% endif %}" data-pp-ot-card="{{ forloop.index0 }}">
        {%- if block.settings.etiqueta != blank -%}<span class="pp-ot__badge">{{ block.settings.etiqueta }}</span>{%- endif -%}
        <div class="pp-ot__fila">
          <div class="pp-ot__img">
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '84px', alt: block.settings.titulo }}
            {%- elsif product.featured_image -%}
              {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '84px', alt: block.settings.titulo }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div>
            <p class="pp-ot__nombre">{{ block.settings.titulo }}</p>
            {%- if block.settings.linea_regalo != blank -%}<p class="pp-ot__regalo">{{ block.settings.linea_regalo }}</p>{%- endif -%}
            {%- if block.settings.detalle != blank -%}<p class="pp-ot__detalle">{{ block.settings.detalle }}</p>{%- endif -%}
          </div>
          <div class="pp-ot__precios">
            <span class="pp-ot__precio">{{ precio | money_without_trailing_zeros }}</span>
            {%- if antes > precio -%}
              <span class="pp-ot__antes">{{ antes | money_without_trailing_zeros }}</span>
              {%- if section.settings.mostrar_ahorro -%}<span class="pp-ot__ahorro">Ahorras {{ antes | minus: precio | money_without_trailing_zeros }}</span>{%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}

    {%- if regalos.size > 0 -%}
      <div class="pp-ot__incluye">
        <div class="pp-ot__inc-head">
          <span>🎁 {{ section.settings.incluye_titulo }}</span>
          <span class="pp-ot__contador" data-pp-ot-contador></span>
        </div>
        <div class="pp-ot__regalos" data-pp-ot-regalos>
          {%- for block in regalos -%}
            <div class="pp-ot__gift" data-min="{{ block.settings.desde | default: 1 }}" {{ block.shopify_attributes }}>
              {%- if block.settings.insignia != blank -%}<span class="pp-ot__ginsignia">{{ block.settings.insignia }}</span>{%- endif -%}
              <span class="pp-ot__gico">
                {%- if block.settings.emoji != blank -%}{{ block.settings.emoji }}{%- else -%}{%- assign icono = block.settings.icono -%}{%- comment -%}PP-ICONOS:START{%- endcomment -%}
{%- case icono -%}
{%- when 'diente' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3C5 3 3.5 4.6 3.5 7c0 2 1 3.4 1.6 5.4.5 1.7.6 3.6 1 5.6.3 1.6.8 3 1.9 3 1.4 0 1.4-3.6 2-5.4.3-1 .9-1.6 2-1.6s1.7.6 2 1.6c.6 1.8.6 5.4 2 5.4 1.1 0 1.6-1.4 1.9-3 .4-2 .5-3.9 1-5.6.6-2 1.6-3.4 1.6-5.4 0-2.4-1.5-4-3.5-4-1.8 0-2.8 1-5 1S8.8 3 7 3z"/></svg>
{%- when 'escudo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
{%- when 'frescura' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9c3 0 3-2 6-2s3 2 6 2 3-2 6-2M3 15c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/></svg>
{%- when 'hoja' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19C5 11 10 5 20 5c0 10-6 15-14 15"/><path d="M5 19l7-7"/></svg>
{%- when 'sonrisa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 14c1 1.5 2.4 2.2 4 2.2s3-.7 4-2.2M9 9.5h.01M15 9.5h.01"/></svg>
{%- when 'brillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3zM19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z"/></svg>
{%- when 'check' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
{%- when 'reloj' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- when 'gota' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3 4 6 7.5 6 11a6 6 0 01-12 0c0-3.5 3-7 6-11z"/></svg>
{%- when 'calendario' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4M9 15l2 2 4-4"/></svg>
{%- when 'camion' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
{%- when 'pago' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
{%- when 'corazon' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg>
{%- when 'lupa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/></svg>
{%- when 'regalo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zm0 0c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>
{%- when 'chat' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-3.9-1L4 20z"/></svg>
