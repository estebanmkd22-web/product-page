{%- comment -%}
  PP · Zonas del problema
  Imagen grande con etiquetas que señalan puntos (posición en %),
  fila de fotos de detalle con su nombre y frase de cierre.
  (ej: "Ahí es donde empieza el problema")
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

{%- assign puntos = section.blocks | where: 'type', 'punto' -%}
{%- assign fotos = section.blocks | where: 'type', 'foto' -%}

<style>
  .pp-zonas__mapa { position: relative; max-width: 760px; margin: 0 auto; }
  .pp-zonas__mapa > img { width: 100%; height: auto; border-radius: var(--pp-radio); }
  .pp-zonas__punto {
    position: absolute; transform: translate(-6px, -50%);
    display: flex; align-items: center; gap: 6px; white-space: nowrap;
  }
  .pp-zonas__punto::before {
    content: ""; width: 12px; height: 12px; flex: 0 0 auto; border-radius: 50%;
    background: var(--pp-acento); box-shadow: 0 0 0 4px rgba(255, 255, 255, .85);
  }
  .pp-zonas__punto span {
    padding: 4px 10px; border-radius: 99px; background: var(--pp-acento); color: #fff;
    font-size: 11px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase;
  }
  .pp-zonas__punto--izq { flex-direction: row-reverse; transform: translate(calc(-100% + 6px), -50%); }
  .pp-zonas__fotos { display: grid; gap: 10px; margin-top: 20px; }
  #pp-zonas-{{ section.id }} .pp-zonas__fotos { grid-template-columns: repeat({{ fotos.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); }
  .pp-zonas__foto { overflow: hidden; border-radius: var(--pp-radio); background: var(--pp-fondo); box-shadow: 0 6px 18px rgba(0, 0, 0, .08); }
  .pp-zonas__foto .pp-img { aspect-ratio: 1 / 1; border-radius: 0; }
  .pp-zonas__foto p { padding: 8px 4px; text-align: center; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; }
  @media (min-width: 750px) {
    .pp-zonas__punto span { font-size: 13px; }
    .pp-zonas__fotos { max-width: 760px; margin: 24px auto 0; gap: 16px; }
    .pp-zonas__foto p { font-size: 13px; }
  }
</style>

<div id="pp-zonas-{{ section.id }}" class="pp pp-section pp-bg--{{ section.settings.fondo }}">
  <div class="pp-wrap">
    <div class="pp-head">
      {%- if section.settings.etiqueta != blank -%}<p class="pp-eyebrow" style="color:var(--pp-texto)">{{ section.settings.etiqueta }}</p>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="pp-h pp-title">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="pp-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    {%- if section.settings.imagen != blank -%}
      <div class="pp-zonas__mapa">
        {{ section.settings.imagen | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 760px) 760px, 100vw' }}
        {%- for block in puntos -%}
          <div class="pp-zonas__punto{% if block.settings.lado == 'izq' %} pp-zonas__punto--izq{% endif %}" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <span>{{ block.settings.texto }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if fotos.size > 0 -%}
      <div class="pp-zonas__fotos">
        {%- for block in fotos -%}
          <div class="pp-zonas__foto" {{ block.shopify_attributes }}>
            <div class="pp-img">
              {%- if block.settings.imagen != blank -%}
                {{ block.settings.imagen | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 350, 500', sizes: '(min-width: 760px) 250px, 33vw', alt: block.settings.texto }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cierre != blank -%}
      <p class="pp-cierre{% if section.settings.cierre_franja %} pp-cierre--franja{% endif %}">{{ section.settings.cierre }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PP · Zonas",
  "tag": "section",
  "class": "pp-zonas-section",
  "settings": [
    {
      "type": "select", "id": "fondo", "label": "Fondo", "default": "fondo-2",
      "options": [
        { "value": "fondo", "label": "Blanco" },
        { "value": "fondo-2", "label": "Alterno (suave)" },
        { "value": "oscuro", "label": "Oscuro" }
      ]
    },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "Tu cepillo no llega igual a todas partes" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titular (la cursiva sale en color de acento)", "default": "<em>Ahí es donde empieza el problema</em>" },
    { "type": "inline_richtext", "id": "texto", "label": "Texto (opcional)" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen principal", "info": "Agrega bloques \"Etiqueta\" para señalar puntos sobre la imagen." },
    { "type": "inline_richtext", "id": "cierre", "label": "Frase de cierre (opcional)", "default": "Cepillar es el comienzo. <em>Enjuagar completa la rutina.</em>" },
    { "type": "checkbox", "id": "cierre_franja", "label": "Frase de cierre en franja de color", "default": false }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Etiqueta sobre la imagen",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto", "default": "Entre dientes" },
        { "type": "range", "id": "x", "label": "Posición horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 30 },
        { "type": "range", "id": "y", "label": "Posición vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 30 },
        {
          "type": "select", "id": "lado", "label": "Texto a qué lado del punto", "default": "der",
          "options": [ { "value": "der", "label": "Derecha" }, { "value": "izq", "label": "Izquierda" } ]
        }
      ]
    },
    {
      "type": "foto",
      "name": "Foto de detalle",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen (cuadrada)" },
        { "type": "text", "id": "texto", "label": "Nombre", "default": "Entre dientes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Zonas",
      "blocks": [
        { "type": "foto", "settings": { "texto": "Entre dientes" } },
        { "type": "foto", "settings": { "texto": "Molares" } },
        { "type": "foto", "settings": { "texto": "Superficies orales" } }
      ]
    }
  ]
}
{% endschema %}
