{%- endcase -%}
{%- comment -%}PP-ICONOS:END{%- endcomment -%}{%- endif -%}
              {{ block.settings.texto }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "PP · Garantía",
  "tag": "section",
  "class": "pp-garantia-section",
  "settings": [
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_tarjeta", "label": "Fondo de la tarjeta", "default": "#a5660f" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#ffffff" },
    { "type": "color", "id": "color_sello", "label": "Texto del sello", "default": "#a5660f" },
    { "type": "checkbox", "id": "nieve", "label": "Nieve cayendo en la tarjeta", "default": false },
    { "type": "header", "content": "Sello" },
    { "type": "text", "id": "sello_arriba", "label": "Texto arriba", "default": "Garantía" },
    { "type": "text", "id": "sello_numero", "label": "Número", "default": "60" },
    { "type": "text", "id": "sello_abajo", "label": "Texto abajo", "default": "Días" },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta pequeña", "default": "Compra sin riesgo" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Garantía de satisfacción total" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Si no estás satisfecho con tu compra, puedes devolverla dentro de los 60 días para un reembolso completo." }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Píldora",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icono", "label": "Ícono", "default": "check", "options": [{"value": "ninguno", "label": "Sin ícono"}, {"value": "pago", "label": "Pago / billete"}, {"value": "cambio", "label": "Cambio / devolución"}, {"value": "check", "label": "Check"}, {"value": "escudo", "label": "Escudo"}, {"value": "chat", "label": "WhatsApp / chat"}, {"value": "camion", "label": "Camión (envío)"}, {"value": "reloj", "label": "Reloj"}, {"value": "corazon", "label": "Corazón"}, {"value": "estrella", "label": "Estrella"}] },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Calidad garantizada" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PP · Garantía",
      "blocks": [
        { "type": "punto", "settings": { "icono": "pago", "texto": "60 días para devoluciones" } },
        { "type": "punto", "settings": { "icono": "cambio", "texto": "Calidad garantizada" } },
        { "type": "punto", "settings": { "icono": "chat", "texto": "Atención al cliente dedicada" } }
      ]
    }
  ]
}
{% endschema %}
