{%- comment -%}
  PP · Hero + Oferta
  Lo primero que ve el cliente: galería, reseñas, titular, beneficios
  y la caja de compra (precio, ahorro, qué incluye, botón).
  El botón puede abrir EasySell (contraentrega), agregar al carrito
  o llevar a un enlace.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

{%- assign p = section.settings.producto | default: product -%}
{%- assign variante = p.selected_or_first_available_variant -%}
{%- assign precio = variante.price -%}
{%- if section.settings.precio_manual != blank -%}
{%- assign precio = section.settings.precio_manual | times: 100 -%}
{%- endif -%}
{%- assign precio_antes = 0 -%}
{%- if variante.compare_at_price > precio -%}
{%- assign precio_antes = variante.compare_at_price -%}
{%- endif -%}
{%- if section.settings.precio_antes != blank -%}
{%- assign precio_antes = section.settings.precio_antes | times: 100 -%}
{%- endif -%}
{%- assign ahorro = precio_antes | minus: precio -%}
{%- assign imagenes = '' -%}
{%- for i in (1..6) -%}
{%- assign key = 'imagen_' | append: i -%}
{%- if section.settings[key] != blank -%}
{%- assign imagenes = imagenes | append: key | append: ',' -%}
{%- endif -%}
{%- endfor -%}
{%- assign imagenes = imagenes | split: ',' -%}

<style>
  #pp-hero-{{ section.id }} { background: {{ section.settings.fondo }}; }
  .pp-hero { padding: 0 0 36px; }
  .pp-hero__grid { display: grid; gap: 20px; }
  .pp-hero__media { margin: 0 -16px; position: relative; }
  .pp-hero__slides {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .pp-hero__slides::-webkit-scrollbar { display: none; }
  .pp-hero__slide { flex: 0 0 100%; scroll-snap-align: center; aspect-ratio: {{ section.settings.proporcion }}; background: var(--pp-fondo-2); }
  .pp-hero__slide img { width: 100%; height: 100%; object-fit: cover; }
  .pp-hero__dots { display: flex; justify-content: center; gap: 6px; padding-top: 10px; }
  .pp-hero__dots button {
    width: 7px; height: 7px; padding: 0; border: 0; border-radius: 99px;
    background: var(--pp-borde); cursor: pointer; transition: width .2s, background .2s;
  }
  .pp-hero__dots button[aria-current="true"] { width: 20px; background: var(--pp-texto); }

  .pp-hero__info { display: flex; flex-direction: column; gap: 14px; }
  .pp-hero__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .pp-hero__title { font-size: clamp(28px, 7.4vw, 44px); }
  .pp-hero__text { font-size: 16px; }
  .pp-hero__bens { display: grid; gap: 6px; font-size: 15px; font-weight: 600; }
  .pp-hero__bens li { display: flex; align-items: flex-start; gap: 8px; }
  .pp-hero__bens li.pp-hero__ben--ico::before { content: none; }
  .pp-hero__ico { display: inline-grid; place-items: center; color: var(--pp-acento); font-size: 20px; line-height: 1; }
  .pp-hero__bens li::before {
    content: "{{ section.settings.icono_beneficios }}"; flex: 0 0 auto;
    color: var(--pp-acento); font-weight: 900; line-height: 1.5;
  }

  .pp-offer {
    margin-top: 6px; padding: 18px 16px;
    border: 1.5px solid var(--pp-acento); border-radius: var(--pp-radio);
    background: var(--pp-fondo);
  }
  .pp-offer__price { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .pp-offer__now { font-size: 36px; font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  .pp-offer__before { font-size: 20px; font-weight: 600; color: var(--pp-texto-2); text-decoration: line-through; }
  .pp-offer__save {
    padding: 5px 9px; border-radius: 6px; background: var(--pp-acento); color: #fff;
    font-size: 12px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase;
  }
  .pp .pp-offer__inc-title { margin: 18px 0 4px; font-size: 14px; font-weight: 600; }
  .pp-offer__list li {
    display: flex; gap: 10px; padding: 9px 0; font-size: 14px;
    border-top: 1px solid var(--pp-borde);
  }
  .pp-offer__list li:first-child { border-top: 0; }
  .pp-offer__list li::before { content: "✓"; color: var(--pp-ok); font-weight: 900; }
  .pp-offer__cta { margin-top: 14px; }
  .pp .pp-offer__note { margin-top: 10px; font-size: 13px; text-align: center; color: var(--pp-texto-2); }
  .pp-hero__trans { display: grid; gap: 10px; padding: 14px; border-radius: var(--pp-radio); background: var(--pp-fondo-2); font-size: 15px; }
  .pp-hero__trans li { display: flex; align-items: flex-start; gap: 10px; }
  .pp-hero__trans b { color: var(--pp-acento); }
  .pp .pp-offer__entrega { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 10px; font-size: 14px; color: var(--pp-texto-2); }
  .pp-offer__entrega .pp-ico { font-size: 18px; color: var(--pp-acento); }
  .pp-offer__pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 12px; }
  .pp-offer__pay svg { width: 38px; height: 24px; }
  .pp-offer__pay span {
    padding: 4px 8px; border: 1px solid var(--pp-borde); border-radius: 6px;
    font-size: 11px; font-weight: 700; color: var(--pp-texto-2);
  }

  @media (min-width: 900px) {
    .pp-hero { padding: 40px 0 64px; }
    .pp-hero__grid { grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: start; }
    .pp-hero__media { margin: 0; position: sticky; top: 24px; }
    .pp-hero__slide, .pp-hero__slide img { border-radius: var(--pp-radio); }
    .pp-hero__slides { gap: 12px; }
  }
</style>

<div id="pp-hero-{{ section.id }}" class="pp pp-hero">
  <div class="pp-wrap pp-hero__grid">

    {%- comment -%} ===== Galería ===== {%- endcomment -%}
    <div class="pp-hero__media">
      <div class="pp-hero__slides" data-pp-slides>
        {%- if imagenes.size > 0 -%}
          {%- for key in imagenes -%}
            {%- assign img = section.settings[key] -%}
            {%- assign alt = img.alt | default: p.title -%}
            <div class="pp-hero__slide">
              {%- if forloop.first -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200', alt: alt }}
              {%- else -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200', alt: alt }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for media in p.media limit: 6 -%}
            <div class="pp-hero__slide">
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 560px, 100vw', widths: '400, 600, 800, 1000, 1200' }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="pp-hero__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="pp-hero__dots" data-pp-dots></div>
    </div>

    {%- comment -%} ===== Información y oferta ===== {%- endcomment -%}
    <div class="pp-hero__info">
      {%- if section.settings.mostrar_rating -%}
        <div class="pp-hero__rating">
          <span class="pp-stars" aria-hidden="true">★★★★★</span>
          <span><strong>{{ section.settings.rating }}</strong> <span class="pp-muted">{{ section.settings.rating_texto }}</span></span>
        </div>
      {%- endif -%}

      {%- if section.settings.titulo != blank -%}
        <h1 class="pp-h pp-hero__title">{{ section.settings.titulo }}</h1>
      {%- endif -%}

      {%- if section.settings.texto != blank -%}
        <p class="pp-hero__text pp-muted">{{ section.settings.texto }}</p>
      {%- endif -%}

      {%- assign bens = section.blocks | where: 'type', 'beneficio' -%}
      {%- if bens.size > 0 -%}
        <ul class="pp-hero__bens">
          {%- for block in bens -%}
            {%- assign icono = block.settings.icono | default: 'ninguno' -%}
            <li class="{% if icono != 'ninguno' %}pp-hero__ben--ico{% endif %}" {{ block.shopify_attributes }}>
              {%- if icono != 'ninguno' -%}<span class="pp-hero__ico">{%- comment -%}PP-ICONOS:START{%- endcomment -%}
{%- case icono -%}
{%- when 'diente' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3C5 3 3.5 4.6 3.5 7c0 2 1 3.4 1.6 5.4.5 1.7.6 3.6 1 5.6.3 1.6.8 3 1.9 3 1.4 0 1.4-3.6 2-5.4.3-1 .9-1.6 2-1.6s1.7.6 2 1.6c.6 1.8.6 5.4 2 5.4 1.1 0 1.6-1.4 1.9-3 .4-2 .5-3.9 1-5.6.6-2 1.6-3.4 1.6-5.4 0-2.4-1.5-4-3.5-4-1.8 0-2.8 1-5 1S8.8 3 7 3z"/></svg>
{%- when 'escudo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
{%- when 'frescura' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9c3 0 3-2 6-2s3 2 6 2 3-2 6-2M3 15c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/></svg>
{%- when 'hoja' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19C5 11 10 5 20 5c0 10-6 15-14 15"/><path d="M5 19l7-7"/></svg>
{%- when 'sonrisa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 14c1 1.5 2.4 2.2 4 2.2s3-.7 4-2.2M9 9.5h.01M15 9.5h.01"/></svg>
{%- when 'brillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3zM19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z"/></svg>
{%- when 'check' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
{%- when 'reloj' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- when 'gota' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3 4 6 7.5 6 11a6 6 0 01-12 0c0-3.5 3-7 6-11z"/></svg>
{%- when 'calendario' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4M9 15l2 2 4-4"/></svg>
{%- when 'camion' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
{%- when 'pago' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
{%- when 'corazon' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg>
{%- when 'lupa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/></svg>
{%- when 'regalo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zm0 0c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>
{%- when 'chat' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-3.9-1L4 20z"/></svg>
{%- when 'rayo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 13.5h6L10 21l8-10.5h-6L13 3z"/></svg>
{%- when 'bombillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>
{%- when 'usb' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V5"/><path d="M9 6l3-3 3 3"/><path d="M12 15l-4-3V9"/><circle cx="8" cy="8" r="1.4"/><path d="M12 13l4-2.5V8.5"/><path d="M14.8 7h2.4v2.4h-2.4z"/><circle cx="12" cy="20" r="1.4"/></svg>
{%- when 'casa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7"/><path d="M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/></svg>
{%- when 'arbol' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l4 5h-2.5l4 5h-2.5l4 5H5l4-5H6.5l4-5H8l4-5z"/><path d="M12 18v3"/></svg>
{%- when 'estrella' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/></svg>
{%- endcase -%}
{%- comment -%}PP-ICONOS:END{%- endcomment -%}</span>{%- endif -%}
              <span>{{ block.settings.texto }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign trans = section.blocks | where: 'type', 'transformacion' -%}
      {%- if trans.size > 0 -%}
        <ul class="pp-hero__trans">
          {%- for block in trans -%}
            <li {{ block.shopify_attributes }}>
              {%- assign icono = block.settings.icono -%}
              {%- if icono != 'ninguno' -%}<span class="pp-hero__ico">{%- comment -%}PP-ICONOS:START{%- endcomment -%}
{%- case icono -%}
