{%- comment -%}
  PP · Botón fijo
  Barra pegada abajo de la pantalla con el botón de compra. Aparece cuando
  el cliente ya pasó la caja de compra del Hero y se oculta cuando vuelve a verla.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

{%- assign p = product -%}
{%- assign precio = p.selected_or_first_available_variant.price -%}
{%- if section.settings.precio_manual != blank -%}
{%- assign precio = section.settings.precio_manual | times: 100 -%}
{%- endif -%}

<style>
  .pp-fijo {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 9990;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--pp-fondo); box-shadow: 0 -6px 20px rgba(0, 0, 0, .12);
    transform: translateY(110%); transition: transform .25s ease;
  }
  .pp-fijo.is-visible { transform: translateY(0); }
  .pp-fijo__fila { display: flex; align-items: center; gap: 12px; max-width: 560px; margin: 0 auto; }
  .pp-fijo__precio { flex: 0 0 auto; line-height: 1.1; }
  .pp-fijo__precio strong { display: block; font-size: 20px; font-weight: 900; }
  .pp-fijo__precio span { font-size: 12px; color: var(--pp-texto-2); }
  .pp-fijo .pp-btn, .pp-fijo .es-popup-button-overwrite { min-height: 50px !important; font-size: 16px !important; box-shadow: none !important; }
  {%- if section.settings.solo_movil %}
  @media (min-width: 750px) { .pp-fijo { display: none; } }
  {%- endif %}
  @media (prefers-reduced-motion: reduce) { .pp-fijo { transition: none; } }
</style>

<div class="pp pp-fijo" id="pp-fijo-{{ section.id }}" role="region" aria-label="Comprar">
  <div class="pp-fijo__fila">
    {%- if section.settings.mostrar_precio -%}
      <div class="pp-fijo__precio">
        <strong>{{ precio | money_without_trailing_zeros }}</strong>
        {%- if section.settings.subtexto != blank -%}<span>{{ section.settings.subtexto }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.boton_modo == 'easysell' -%}
      <a href="javascript:void(0);" class="es-popup-button-overwrite pp-btn">{{ section.settings.boton_texto }}</a>
    {%- else -%}
      <a href="#oferta" class="pp-btn">{{ section.settings.boton_texto }}</a>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var barra = document.getElementById('pp-fijo-{{ section.id }}');
    if (!barra) return;
    var oferta = document.getElementById('oferta') || document.querySelector('.pp-of, [data-pp-oferta]');
    var packs = document.querySelector('.pp-of, [data-pp-oferta]');
    var precioFijo = barra.querySelector('.pp-fijo__precio strong');
    function precioPack() {
      var r = packs && packs.querySelector('input[data-precio]:checked');
      if (r && precioFijo && r.dataset.precio) precioFijo.textContent = r.dataset.precio;
    }
    if (packs) { packs.addEventListener('change', precioPack); precioPack(); }
    var irOferta = barra.querySelector('a[href="#oferta"]');
    if (irOferta && oferta) irOferta.addEventListener('click', function (ev) { ev.preventDefault(); oferta.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    var heroConOferta = !!document.getElementById('oferta');
    function actualizar() {
      var bajo = !heroConOferta || window.scrollY > Math.min(250, window.innerHeight * 0.3);
      var tapa = false;
      if (oferta) {
        var r = oferta.getBoundingClientRect();
        tapa = r.top < window.innerHeight * 0.75 && r.bottom > window.innerHeight * 0.3;
      }
      barra.classList.toggle('is-visible', bajo && !tapa);
    }
    window.addEventListener('scroll', function () { window.requestAnimationFrame(actualizar); }, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  })();
</script>

{% schema %}
{
  "name": "PP · Botón fijo",
  "tag": "section",
  "class": "pp-fijo-section",
  "settings": [
    { "type": "paragraph", "content": "Barra pegada abajo con el botón de compra. Aparece cuando el cliente pasa la caja de compra del Hero." },
    { "type": "checkbox", "id": "solo_movil", "label": "Mostrar solo en celular", "default": true },
    { "type": "checkbox", "id": "mostrar_precio", "label": "Mostrar el precio", "default": true },
    { "type": "number", "id": "precio_manual", "label": "Precio a mostrar (opcional, ej: 210)" },
    { "type": "text", "id": "subtexto", "label": "Texto debajo del precio", "default": "Envío gratis" },
    {
      "type": "select", "id": "boton_modo", "label": "¿Qué hace el botón?", "default": "easysell",
      "options": [
        { "value": "easysell", "label": "Abrir formulario EasySell" },
        { "value": "oferta", "label": "Subir a la caja de compra" }
      ]
    },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Pedir ahora — Pagás al recibir" }
  ],
  "presets": [{ "name": "PP · Botón fijo" }]
}
{% endschema %}
