{%- comment -%}
  PP · Estilos globales
  Agrégala UNA vez por plantilla (arriba del todo). No se ve en la página:
  solo define los colores que usan todas las secciones PP.
{%- endcomment -%}

<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>

<style>
  :root {
    --pp-acento: {{ section.settings.acento }};
    --pp-acento-suave: {{ section.settings.acento | color_mix: '#ffffff', 12 }};
    --pp-texto: {{ section.settings.texto }};
    --pp-texto-2: {{ section.settings.texto_2 }};
    --pp-fondo: {{ section.settings.fondo }};
    --pp-fondo-2: {{ section.settings.fondo_2 }};
    --pp-ok: {{ section.settings.ok }};
    --pp-estrella: {{ section.settings.estrella }};
    --pp-boton: {{ section.settings.boton }};
    --pp-boton-texto: {{ section.settings.boton_texto }};
    --pp-radio: {{ section.settings.radio }}px;
    {%- if section.settings.fuente_propia %}
    --pp-font-titulos: {{ section.settings.fuente_titulos.family }}, {{ section.settings.fuente_titulos.fallback_families }};
    --pp-peso-titulos: {{ section.settings.fuente_titulos.weight }};
    {%- endif %}
    {%- if section.settings.mayusculas %}
    --pp-mayus-titulos: uppercase;
    --pp-espaciado-titulos: 0;
    {%- endif %}
  }
</style>
{%- if section.settings.fuente_propia -%}
<style>
  {{ section.settings.fuente_titulos | font_face: font_display: 'swap' }}
</style>
{%- endif -%}

{% schema %}
{
  "name": "PP · Estilos globales",
  "tag": "div",
  "class": "pp-estilos",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Colores de todas las secciones PP de esta página. Agrega esta sección una sola vez, arriba del todo."
    },
    { "type": "header", "content": "Marca" },
    { "type": "color", "id": "acento", "label": "Color de acento (títulos resaltados, etiquetas)", "default": "#c5453f" },
    { "type": "color", "id": "boton", "label": "Fondo del botón de compra", "default": "#c5453f" },
    { "type": "color", "id": "boton_texto", "label": "Texto del botón de compra", "default": "#ffffff" },
    { "type": "header", "content": "Texto y fondos" },
    { "type": "color", "id": "texto", "label": "Texto principal", "default": "#1e1e1e" },
    { "type": "color", "id": "texto_2", "label": "Texto secundario", "default": "#5c5c5c" },
    { "type": "color", "id": "fondo", "label": "Fondo", "default": "#ffffff" },
    { "type": "color", "id": "fondo_2", "label": "Fondo alterno (franjas)", "default": "#f7f4f0" },
    { "type": "header", "content": "Detalles" },
    { "type": "color", "id": "ok", "label": "Color de los checks ✓", "default": "#2e8b57" },
    { "type": "color", "id": "estrella", "label": "Color de las estrellas", "default": "#f5b301" },
    { "type": "range", "id": "radio", "label": "Redondeo de tarjetas e imágenes", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 14 },
    { "type": "header", "content": "Títulos" },
    { "type": "checkbox", "id": "fuente_propia", "label": "Usar otra fuente para los títulos", "default": false, "info": "Si no la activas, se usa la fuente de títulos de tu tema." },
    { "type": "font_picker", "id": "fuente_titulos", "label": "Fuente de los títulos", "default": "helvetica_n7", "info": "Para un estilo deportivo prueba fuentes condensadas como Oswald." },
    { "type": "checkbox", "id": "mayusculas", "label": "Títulos en MAYÚSCULAS", "default": false }
  ],
  "presets": [{ "name": "PP · Estilos globales" }]
}
{% endschema %}
