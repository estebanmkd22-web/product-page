{%- comment -%}
  PP · Problemas en filas
  Titular con palabra destacada y filas alternadas de foto + tarjeta
  (ícono en círculo, título, divisor dorado y puntos con check).
{%- endcomment -%}
<style>
/* PP-BASE:START */
/* PP · Base compartida. Fuente única: src/pp-base.css
   (tools/inline-base.mjs la copia dentro de cada sección).
   Todo va dentro de :where() para tener prioridad mínima: como esta base
   se repite en cada sección, nunca debe pisar los estilos propios de una
   sección ni los colores de "PP · Estilos globales". */
:where(:root) {
  --pp-acento: #c5453f;
  --pp-acento-suave: #fbeceb;
  --pp-texto: #1e1e1e;
  --pp-texto-2: #5c5c5c;
  --pp-fondo: #ffffff;
  --pp-fondo-2: #f7f4f0;
  --pp-borde: rgba(0, 0, 0, 0.1);
  --pp-ok: #2e8b57;
  --pp-estrella: #f5b301;
  --pp-boton: #c5453f;
  --pp-boton-texto: #ffffff;
  --pp-radio: 14px;
  --pp-ancho: 1120px;
}

.pp,
.pp *,
.pp *::before,
.pp *::after {
  box-sizing: border-box;
}

:where(.pp) {
  color: var(--pp-texto);
  background: var(--pp-fondo);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

:where(.pp) img {
  display: block;
  max-width: 100%;
  height: auto;
}

:where(.pp) :where(h1, h2, h3, p, ul) {
  margin: 0;
}

/* Dawn pinta todos los h1-h5 con su color y fuente de títulos. Esta regla
   (especificidad de un solo elemento, igual a la de Dawn pero declarada después)
   hace que hereden de la sección; cualquier regla con clase le sigue ganando. */
:where(.pp) :is(h1, h2, h3, h4, h5) {
  color: inherit;
  font-family: inherit;
  letter-spacing: inherit;
}

:where(.pp) ul {
  padding: 0;
  list-style: none;
}

.pp-wrap {
  width: 100%;
  max-width: var(--pp-ancho);
  margin: 0 auto;
  padding: 0 16px;
}

/* Títulos: fuente propia (PP · Estilos globales) o la de títulos del tema */
.pp-h {
  font-family: var(--pp-font-titulos, var(--font-heading-family, inherit));
  font-weight: var(--pp-peso-titulos, 800);
  line-height: 1.1;
  letter-spacing: var(--pp-espaciado-titulos, -0.01em);
  text-transform: var(--pp-mayus-titulos, none);
  color: var(--pp-texto);
}

.pp-h em,
.pp-h i {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--pp-acento);
}

.pp-muted {
  color: var(--pp-texto-2);
}

/* Estrellas */
.pp-stars {
  display: inline-flex;
  gap: 1px;
  color: var(--pp-estrella);
  font-size: 16px;
  letter-spacing: 0;
  line-height: 1;
}

/* Botón principal */
.pp-btn,
.pp .es-popup-button-overwrite {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px;
  width: 100% !important;
  min-height: 56px !important;
  padding: 14px 20px !important;
  border: 0 !important;
  border-radius: 12px !important;
  background: var(--pp-boton) !important;
  color: var(--pp-boton-texto) !important;
  font-family: inherit !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
  text-align: center !important;
  text-decoration: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14) !important;
  transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  -webkit-appearance: none;
  appearance: none;
}

.pp-btn:active,
.pp .es-popup-button-overwrite:active {
  transform: scale(0.98);
}

.pp-btn small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  opacity: 0.9;
  letter-spacing: 0.02em;
}

.pp-btn--pulse {
  animation: pp-pulse 2s ease-in-out infinite;
}

@keyframes pp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .pp-btn--pulse {
    animation: none;
  }
}

/* Espaciado vertical estándar de sección */
.pp-section {
  padding: 40px 0;
}

@media (min-width: 750px) {
  .pp-section {
    padding: 64px 0;
  }
}

/* Fondos de franja (para alternar secciones) */
.pp-bg--fondo-2 {
  background: var(--pp-fondo-2);
}

.pp-bg--oscuro {
  background: var(--pp-texto);
  color: var(--pp-fondo);
}

.pp-bg--oscuro .pp-h,
.pp-bg--oscuro .pp-muted {
  color: inherit;
}

/* Encabezado de sección */
.pp-head {
  display: grid;
  gap: 10px;
  max-width: 720px;
  margin: 0 auto 28px;
  text-align: center;
}

.pp-head--izq {
  margin-left: 0;
  text-align: left;
}

.pp-title {
  font-size: clamp(26px, 6.6vw, 40px);
}

.pp-lead {
  font-size: 16px;
  color: var(--pp-texto-2);
}

/* Contenedor de imagen con proporción fija */
.pp-img {
  overflow: hidden;
  border-radius: var(--pp-radio);
  background: var(--pp-fondo-2);
}

.pp-img img,
.pp-img svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pp-cta {
  max-width: 480px;
  margin: 28px auto 0;
}

/* Íconos de línea (se eligen en el panel) */
.pp-ico {
  width: 1em;
  height: 1em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex: 0 0 auto;
}

/* Frase de cierre al final de una sección */
.pp .pp-cierre {
  margin: 28px auto 0;
  max-width: 760px;
  text-align: center;
  font-family: var(--font-heading-family, inherit);
  font-size: clamp(20px, 5.2vw, 28px);
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
}

.pp-cierre em {
  font-style: normal;
  color: var(--pp-acento);
}

.pp-cierre--franja {
  padding: 16px 18px;
  border-radius: var(--pp-radio);
  background: var(--pp-acento);
  color: #fff;
  font-size: clamp(16px, 4.4vw, 22px);
}

.pp-cierre--franja em {
  color: inherit;
  text-decoration: underline;
}
/* PP-BASE:END */
</style>
<style>
  #pp-pf-{{ section.id }} {
    --pf-bg: {{ section.settings.color_fondo }}; --pf-card: {{ section.settings.color_tarjeta }}; --pf-ac: {{ section.settings.color_acento }}; --pf-au: {{ section.settings.color_dorado }}; --pf-tx: {{ section.settings.color_texto }};
    background: var(--pf-bg); color: var(--pf-tx);
  }
  .pp-pf__head { text-align: center; }
  .pp-pf__deco { display: flex; align-items: center; justify-content: center; gap: 10px; color: var(--pf-au); font-size: 13px; margin-bottom: 8px; }
  .pp-pf__deco::before, .pp-pf__deco::after { content: ""; width: 60px; height: 1px; background: linear-gradient(90deg, transparent, currentColor, transparent); }
  #pp-pf-{{ section.id }} .pp-pf__titulo { margin: 0 auto; max-width: 20ch; color: var(--pf-ac); font-size: clamp(25px, 6.8vw, 42px); line-height: 1.12; }
  #pp-pf-{{ section.id }} .pp-pf__titulo em { color: var(--pf-au); font-style: italic; }
  .pp-pf__sub { margin: 10px auto 0; max-width: 46ch; font-size: clamp(14px, 3.8vw, 17px); line-height: 1.45; opacity: .85; }
  .pp-pf__filas { display: grid; gap: 16px; margin-top: 24px; }
  .pp-pf__fila { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; border-radius: 20px; overflow: hidden; background: var(--pf-card); box-shadow: 0 10px 28px -18px rgba(60, 35, 20, .5); }
  .pp-pf__fila:nth-child(even) .pp-pf__foto { order: 2; }
  .pp-pf__foto { position: relative; min-height: 190px; }
  .pp-pf__foto img, .pp-pf__foto svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pp-pf--fade .pp-pf__foto img, .pp-pf--fade .pp-pf__foto svg { -webkit-mask-image: linear-gradient(90deg, #000 70%, transparent); mask-image: linear-gradient(90deg, #000 70%, transparent); }
  .pp-pf--fade .pp-pf__fila:nth-child(even) .pp-pf__foto img, .pp-pf--fade .pp-pf__fila:nth-child(even) .pp-pf__foto svg { -webkit-mask-image: linear-gradient(270deg, #000 70%, transparent); mask-image: linear-gradient(270deg, #000 70%, transparent); }
  .pp-pf__card { display: grid; align-content: center; justify-items: center; gap: 6px; padding: 18px 12px; text-align: center; }
  .pp-pf__ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: var(--pf-ac); color: #fff; font-size: 22px; box-shadow: 0 0 0 4px color-mix(in srgb, var(--pf-ac) 18%, transparent); }
  #pp-pf-{{ section.id }} .pp-pf__t { margin: 4px 0 0; color: var(--pf-ac); font-size: clamp(16px, 4.4vw, 22px); line-height: 1.15; }
  .pp-pf__div { display: flex; align-items: center; gap: 6px; color: var(--pf-au); font-size: 8px; }
  .pp-pf__div::before, .pp-pf__div::after { content: ""; width: 24px; height: 1px; background: currentColor; }
  .pp-pf__puntos { display: grid; gap: 6px; margin: 2px 0 0; padding: 0; list-style: none; text-align: left; }
  .pp-pf__puntos li { display: grid; grid-template-columns: 16px 1fr; gap: 6px; align-items: start; font-size: clamp(12px, 3.3vw, 15px); line-height: 1.35; }
  .pp-pf__puntos li::before { content: "✓"; display: grid; place-items: center; width: 16px; height: 16px; margin-top: 1px; border-radius: 50%; background: var(--pf-au); color: #fff; font-size: 10px; font-weight: 700; }
  .pp-pf__cierre { margin: 22px auto 0; max-width: 40ch; text-align: center; color: var(--pf-ac); font-size: clamp(16px, 4.4vw, 20px); line-height: 1.35; }
  @media (min-width: 750px) {
    .pp-pf__filas { gap: 22px; margin-top: 36px; }
    .pp-pf__foto { min-height: 300px; }
    .pp-pf__card { padding: 28px 32px; gap: 10px; }
    .pp-pf__ico { width: 58px; height: 58px; font-size: 28px; }
  }
</style>
<div id="pp-pf-{{ section.id }}" class="pp pp-section{% if section.settings.difuminar %} pp-pf--fade{% endif %}">
  <div class="pp-wrap">
    <div class="pp-pf__head">
      {%- if section.settings.adorno -%}<p class="pp-pf__deco" aria-hidden="true">✦</p>{%- endif -%}
      {%- if section.settings.titulo != blank or section.settings.titulo_dorado != blank -%}<h2 class="pp-h pp-pf__titulo">{{ section.settings.titulo }}{% if section.settings.titulo_dorado != blank %} <em>{{ section.settings.titulo_dorado }}</em>{% endif %}{{ section.settings.titulo_fin }}</h2>{%- endif -%}
      {%- if section.settings.subtitulo != blank -%}<p class="pp-pf__sub">{{ section.settings.subtitulo }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="pp-pf__filas">
        {%- for block in section.blocks -%}
          <div class="pp-pf__fila" {{ block.shopify_attributes }}>
            <div class="pp-pf__foto">
              {%- if block.settings.imagen != blank -%}
                {{ block.settings.imagen | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1120px) 544px, 50vw', alt: block.settings.titulo }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="pp-pf__card">
              {%- if block.settings.icono != 'ninguno' -%}
                <span class="pp-pf__ico">{%- assign icono = block.settings.icono -%}{%- comment -%}PP-ICONOS:START{%- endcomment -%}
{%- case icono -%}
{%- when 'diente' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3C5 3 3.5 4.6 3.5 7c0 2 1 3.4 1.6 5.4.5 1.7.6 3.6 1 5.6.3 1.6.8 3 1.9 3 1.4 0 1.4-3.6 2-5.4.3-1 .9-1.6 2-1.6s1.7.6 2 1.6c.6 1.8.6 5.4 2 5.4 1.1 0 1.6-1.4 1.9-3 .4-2 .5-3.9 1-5.6.6-2 1.6-3.4 1.6-5.4 0-2.4-1.5-4-3.5-4-1.8 0-2.8 1-5 1S8.8 3 7 3z"/></svg>
{%- when 'escudo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
{%- when 'frescura' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9c3 0 3-2 6-2s3 2 6 2 3-2 6-2M3 15c3 0 3-2 6-2s3 2 6 2 3-2 6-2"/></svg>
{%- when 'hoja' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19C5 11 10 5 20 5c0 10-6 15-14 15"/><path d="M5 19l7-7"/></svg>
{%- when 'sonrisa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 14c1 1.5 2.4 2.2 4 2.2s3-.7 4-2.2M9 9.5h.01M15 9.5h.01"/></svg>
{%- when 'brillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3zM19 16l.7 1.8 1.8.7-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7L19 16z"/></svg>
{%- when 'check' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
{%- when 'reloj' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- when 'gota' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3 4 6 7.5 6 11a6 6 0 01-12 0c0-3.5 3-7 6-11z"/></svg>
{%- when 'calendario' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4M9 15l2 2 4-4"/></svg>
{%- when 'camion' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
{%- when 'pago' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
{%- when 'corazon' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg>
{%- when 'lupa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/></svg>
{%- when 'regalo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zm0 0c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>
{%- when 'chat' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-3.9-1L4 20z"/></svg>
{%- when 'rayo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3L5 13.5h6L10 21l8-10.5h-6L13 3z"/></svg>
{%- when 'bombillo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>
{%- when 'usb' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V5"/><path d="M9 6l3-3 3 3"/><path d="M12 15l-4-3V9"/><circle cx="8" cy="8" r="1.4"/><path d="M12 13l4-2.5V8.5"/><path d="M14.8 7h2.4v2.4h-2.4z"/><circle cx="12" cy="20" r="1.4"/></svg>
{%- when 'casa' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7"/><path d="M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/></svg>
{%- when 'arbol' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l4 5h-2.5l4 5h-2.5l4 5H5l4-5H6.5l4-5H8l4-5z"/><path d="M12 18v3"/></svg>
{%- when 'estrella' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/></svg>
{%- when 'manual' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5c-.8 0-1.5-.7-1.5-1.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v16h5.5c.8 0 1.5-.7 1.5-1.5v-13z"/><path d="M6.5 8H9M6.5 11H9M15 8h2.5M15 11h2.5"/></svg>
{%- when 'altura' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18"/><path d="M8.5 6.5L12 3l3.5 3.5"/><path d="M8.5 17.5L12 21l3.5-3.5"/><path d="M5 3h3M5 21h3"/></svg>
{%- when 'enredo' -%}<svg class="pp-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12c0-4 3-7 7-7 3 0 5 2 5 4.5S14 14 11.5 14 8 12 9 10s4-2 6 0 3 5 1 7-6 2-8 0"/><path d="M16 17l3 3M4 12l-1 3"/></svg>
{%- endcase -%}
{%- comment -%}PP-ICONOS:END{%- endcomment -%}</span>
              {%- endif -%}
              {%- if block.settings.titulo != blank -%}<h3 class="pp-h pp-pf__t">{{ block.settings.titulo }}</h3>{%- endif -%}
              <span class="pp-pf__div" aria-hidden="true">✦</span>
              {%- assign puntos = block.settings.puntos | newline_to_br | split: '<br />' -%}
              {%- if block.settings.puntos != blank -%}
                <ul class="pp-pf__puntos">
                  {%- for p in puntos -%}{%- assign pt = p | strip -%}{%- if pt != blank -%}<li>{{ pt }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.cierre != blank -%}<p class="pp-h pp-pf__cierre">{{ section.settings.cierre }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "PP · Problemas en filas",
  "tag": "section",
  "class": "pp-problemas-filas-section",
  "settings": [
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#f8f4ee" },
    { "type": "color", "id": "color_tarjeta", "label": "Fondo de las tarjetas", "default": "#ffffff" },
    { "type": "color", "id": "color_acento", "label": "Títulos y círculo del ícono", "default": "#8e3b2a" },
    { "type": "color", "id": "color_dorado", "label": "Dorado (palabra destacada, checks, adornos)", "default": "#b8924a" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#3d3530" },
    { "type": "checkbox", "id": "adorno", "label": "Mostrar adorno sobre el título", "default": true },
    { "type": "checkbox", "id": "difuminar", "label": "Difuminar el borde de las fotos", "default": true },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "titulo", "label": "Título (inicio)", "default": "¿Cansada de pasar horas intentando que tu casa luzca" },
    { "type": "text", "id": "titulo_dorado", "label": "Título (parte dorada en cursiva)", "default": "festiva y elegante" },
    { "type": "text", "id": "titulo_fin", "label": "Título (final)", "default": "?" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo" },
    { "type": "text", "id": "cierre", "label": "Frase de cierre" }
  ],
  "blocks": [
    {
      "type": "fila",
      "name": "Fila",
      "limit": 6,
